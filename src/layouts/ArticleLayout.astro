---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';
import { resourceCategories } from '../config/resourceCategories';
import { gradGuideByDept } from '../config/gradTemplates';
import { getCollection } from 'astro:content';

interface TocItem {
  href: string;
  label: string;
}

interface RelatedArticle {
  badge: string;
  title: string;
  href: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  lead: string;
  bodyClass?: string;
  sidebarCtaText: string;
  sidebarCtaUtm: string;
  bottomCtaH2: string;
  bottomCtaP?: string;
  bottomCtaUtm: string;
  tocItems: TocItem[];
  relatedArticles: RelatedArticle[];
  faqItems?: { q: string; a: string }[];
  slug: string;
  seoTitle?: string;
  category?: string;
  departmentGroup?: string;
  gradStage?: number;
  publishDate: Date;
  updatedDate?: Date;
  readingMinutes?: number;
}

const {
  title, description, kicker, lead,
  bodyClass = 'sub-page article-page',
  sidebarCtaText, sidebarCtaUtm,
  bottomCtaH2, bottomCtaUtm,
  tocItems, relatedArticles, faqItems, slug, seoTitle, category, departmentGroup, gradStage,
  publishDate, updatedDate, readingMinutes,
} = Astro.props;

// 各 category（分科研究所再依 departmentGroup）對應的主題指南。
// 用來在麵包屑插入「所屬指南」層，建立 hub-and-spoke 內部連結；沒對應的分類就維持三層。
const GUIDE_BY_CATEGORY: Record<string, { href: string; label: string }> = {
  '申請策略': { href: '/pages/guides/admission-overview.html', label: '申請策略全局觀' },
  '備審製作': { href: '/pages/guides/portfolio-prep.html', label: '備審與學習歷程指南' },
  '升大學前準備': { href: '/pages/guides/pre-college.html', label: '升大學前準備指南' },
  '面試準備': { href: '/pages/guides/interview.html', label: '升學面試準備指南' },
  '各科系指南': { href: '/pages/guides/departments.html', label: '各科系申請指南' },
  '研究所推甄': { href: '/pages/guides/graduate-application.html', label: '研究所推甄完整指南' },
  '給家長': { href: '/pages/guides/parents-guide.html', label: '給家長完整指南' },
};
// 學群 → 指南的對應在 src/config/gradTemplates.ts（與對照表、搜尋資料同一份來源）
const GUIDE_BY_DEPT = gradGuideByDept;
// 研究所推甄文章若帶 departmentGroup（分學群專屬文）→ 連到該學群研究所指南；
// 其餘（含通用研究所文、大學端各科系文）→ 連到該 category 的指南。
const guide = ((category === '研究所推甄' && departmentGroup ? GUIDE_BY_DEPT[departmentGroup] : undefined)
  ?? (category ? GUIDE_BY_CATEGORY[category] : undefined)) ?? null;

// 文章 → 對應服務頁的就地連結（資料驅動，依 category 對應；沒有對應的分類就不顯示）。
// 補上全站最弱的轉換路徑：讀者不必繞主導覽即可從內容走向服務。
const SERVICE_BY_CATEGORY: Record<string, { href: string; label: string }> = {
  '研究所推甄': { href: '/pages/services/graduate.html', label: '看研究所推甄服務' },
  '面試準備': { href: '/pages/services/interview-training.html', label: '看面試訓練服務' },
  '備審製作': { href: '/pages/services/college-application.html', label: '看備審輔導服務' },
  '各科系指南': { href: '/pages/services/college-application.html', label: '看備審輔導服務' },
  '申請策略': { href: '/pages/services.html', label: '看服務與方案' },
  '升大學前準備': { href: '/pages/services.html', label: '看服務與方案' },
  '材料累積': { href: '/pages/services.html', label: '看服務與方案' },
  '給家長': { href: '/pages/services.html', label: '看服務與方案' },
};
const serviceLink = (category && SERVICE_BY_CATEGORY[category]) ?? null;

// 麵包屑層級（含可選的指南層），同時供 HTML 與 BreadcrumbList schema 使用。
const crumbs = [
  { name: '首頁', url: `${site.siteUrl}/index.html`, href: '/index.html' },
  { name: '知識庫', url: `${site.siteUrl}/pages/resources.html`, href: '/pages/resources.html' },
  ...(guide ? [{ name: guide.label, url: `${site.siteUrl}${guide.href}`, href: guide.href }] : []),
  { name: title, url: `${site.siteUrl}/pages/resources/${slug}.html`, href: '' },
];

// ── 研究所申請系列：階段(縱) × 軌道(橫) 矩陣導覽 ──
// 軌道 = departmentGroup（沒有就是「通用」）。縱向走同軌相鄰階段（該軌缺就回退通用），
// 橫向列同階段的其他軌道版本。隨學群增加自動長出，不必手改舊文。
const GRAD_STAGE_LABELS: Record<number, string> = {
  1: '推甄 vs 考試', 2: '時程規劃', 3: '選校選教授', 4: '聯繫教授',
  5: '研究計畫書', 6: '備審／作品集', 7: '口試',
};
let seriesNav: null | {
  track: string; stage: number;
  prev: { title: string; href: string } | null;
  next: { title: string; href: string } | null;
  others: { track: string; title: string; href: string }[];
  // others 為空時的替代出口：階段 1（推甄vs考試）與階段 4（聯繫教授）沒有分學群專屬文，
  // 但它們是漏斗最上層，不能是死路——改列各學群的完整指南。
  guides: { track: string; label: string; href: string }[];
  stages: { n: number; label: string; href: string; current: boolean }[];
} = null;
if (gradStage) {
  const track = departmentGroup ?? '通用';
  const gradArticles = (await getCollection('articles'))
    .filter((a) => a.data.category === '研究所推甄' && a.data.gradStage);
  const trackOf = (a: any) => a.data.departmentGroup ?? '通用';
  const cell = (stg: number, trk: string) =>
    gradArticles.find((a) => a.data.gradStage === stg && trackOf(a) === trk);
  const link = (a: any) => (a ? { title: a.data.title, href: `/pages/resources/${a.slug}.html` } : null);
  const prevA = gradStage > 1 ? (cell(gradStage - 1, track) ?? cell(gradStage - 1, '通用')) : null;
  const nextA = gradStage < 7 ? (cell(gradStage + 1, track) ?? cell(gradStage + 1, '通用')) : null;
  const others = gradArticles
    .filter((a) => a.data.gradStage === gradStage && trackOf(a) !== track)
    // 只把「通用版」往前排，其餘維持 collection 原順序（故不需要第二個參數）
    .sort((a) => (trackOf(a) === '通用' ? -1 : 1))
    .map((a) => ({ track: trackOf(a), title: a.data.title, href: `/pages/resources/${a.slug}.html` }));
  // 側欄用：當前軌的完整 7 階段（該軌缺則回退通用），標出目前所在
  const stages = [1, 2, 3, 4, 5, 6, 7]
    .map((n) => {
      const a = cell(n, track) ?? cell(n, '通用');
      return a ? { n, label: GRAD_STAGE_LABELS[n], href: `/pages/resources/${a.slug}.html`, current: n === gradStage } : null;
    })
    .filter((x): x is { n: number; label: string; href: string; current: boolean } => x !== null);
  const guides = others.length === 0
    ? Object.entries(GUIDE_BY_DEPT).map(([t, g]) => ({ track: t, label: g.label, href: g.href }))
    : [];
  seriesNav = { track, stage: gradStage, prev: link(prevA), next: link(nextA), others, guides, stages };
}

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "url": `${site.siteUrl}/pages/resources/${slug}.html`,
      "datePublished": publishDate.toISOString(),
      "dateModified": (updatedDate ?? publishDate).toISOString(),
      "author": { "@type": "Organization", "name": "TBD Studio", "url": site.siteUrl },
      "publisher": { "@type": "Organization", "name": "TBD Studio", "url": site.siteUrl },
      "inLanguage": "zh-TW"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": crumbs.map((c, i) => ({
        "@type": "ListItem", "position": i + 1, "name": c.name, "item": c.url
      }))
    },
    // FAQPage：有填 faqItems 才加，讓文末 FAQ 能被 Google 當結構化資料
    ...(faqItems && faqItems.length ? [{
      "@type": "FAQPage",
      "mainEntity": faqItems.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    }] : []),
  ]
};

// 結尾 CTA 段落 fallback 鏈：文章自訂 → 分類預設 → 全站通用
const categoryCtaP = resourceCategories.find((c) => c.category === category)?.ctaParagraph;
const bottomCtaP = Astro.props.bottomCtaP ?? categoryCtaP ?? 'TBD 的第一次策略諮詢會先依據學生的升學管道、競爭力與目前最該補強的環節進行評估與建議，線上與您一起討論可能合作方案，決定是否需要文件重構、面試訓練或全程陪跑。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=${sidebarCtaUtm}`;
const bottomCtaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=${bottomCtaUtm}`;

// Hero meta bar：作者背書＋時效訊號（v3 review 通用規範）
const metaDate = updatedDate ?? publishDate;
const metaDateLabel = `${metaDate.getFullYear()} 年 ${metaDate.getMonth() + 1} 月`;
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} ogType="article" seoTitle={seoTitle} schema={articleSchema}>
  <section class="hero article-hero">
    <nav class="breadcrumb">
      <a href="/index.html">首頁</a>
      <span>›</span>
      <a href="/pages/resources.html">知識庫</a>
      <span>›</span>
      {guide && (<><a href={guide.href}>{guide.label}</a><span>›</span></>)}
      <span>{title}</span>
    </nav>
    <span class="kicker">{kicker}</span>
    <h1>{title}</h1>
    <p class="article-meta"><span>TBD Studio 編輯團隊</span><span aria-hidden="true">·</span><span>{updatedDate ? '更新於' : '發布於'} {metaDateLabel}</span>{readingMinutes && (<><span aria-hidden="true">·</span><span>閱讀約 {readingMinutes} 分鐘</span></>)}</p>
    <p class="lead">{lead}</p>
  </section>

  <main>
    <div class="article-layout">

      <article class="article-body">
        <slot />
      </article>

      <div class="article-sidebar">
        <div class="pg-sidebar article-toc">
          <div class="pg-sidebar-head">
            <span class="pg-sidebar-kicker">本文目錄</span>
            <button type="button" class="pg-guide-toggle" id="article-toc-toggle" aria-expanded="false" aria-controls="article-toc-nav" aria-label="展開或收起目錄">
              <span class="pg-guide-toggle-text">展開</span>
              <span class="pg-guide-toggle-chevron" aria-hidden="true">▾</span>
            </button>
          </div>
          <nav class="pg-sidebar-nav" id="article-toc-nav">
            {tocItems.map(item => (
              <a href={item.href} class="pg-sidebar-link">{item.label}</a>
            ))}
          </nav>
        </div>

        {seriesNav && (
          <div class="pg-sidebar series-rail">
            <div class="pg-sidebar-head">
              <span class="pg-sidebar-kicker">研究所申請 · {seriesNav.track}軌</span>
            </div>
            <nav class="pg-sidebar-nav">
              {seriesNav.stages.map((s) => (
                <a href={s.href} class={s.current ? 'pg-sidebar-link active' : 'pg-sidebar-link'} aria-current={s.current ? 'page' : undefined}>
                  <span class="series-rail-n">{s.n}</span>{s.label}
                </a>
              ))}
            </nav>
          </div>
        )}

        <div class="sidebar-cta card">
          <p>{sidebarCtaText}</p>
          <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_article_sidebar">預約策略諮詢</a>
        </div>
      </div>

    </div>

    {seriesNav && (
      <section class="section series-nav">
        <h2>研究所申請系列導覽</h2>
        <p class="series-nav-pos">你在「<strong>{seriesNav.track}</strong>」軌 · 階段 <strong>{seriesNav.stage}</strong>／7{guide && (<> · <a class="text-link" href={guide.href}>看完整 7 階段</a></>)}</p>
        <div class="series-nav-axis">
          <span class="series-nav-label">縱向 · 同軌相鄰階段</span>
          <div class="button-row">
            {seriesNav.prev && <a class="button secondary" href={seriesNav.prev.href}>← 階段 {seriesNav.stage - 1}：{seriesNav.prev.title}</a>}
            {seriesNav.next && <a class="button secondary" href={seriesNav.next.href}>階段 {seriesNav.stage + 1}：{seriesNav.next.title} →</a>}
          </div>
        </div>
        {seriesNav.others.length > 0 && (
          <div class="series-nav-axis">
            <span class="series-nav-label">橫向 · 這個階段的其他版本</span>
            <div class="button-row">
              {seriesNav.others.map((o) => (
                <a class="button secondary" href={o.href}>{o.track}版：{o.title}</a>
              ))}
            </div>
          </div>
        )}
        {seriesNav.guides.length > 0 && (
          <div class="series-nav-axis">
            <span class="series-nav-label">橫向 · 這個階段各學群共用，往下看你的學群</span>
            <div class="button-row">
              {seriesNav.guides.map((g) => (
                // label 本身已含學群名（「理工研究所申請指南」），不再前綴 track，
                // 否則會變成「理工：理工研究所申請指南」
                <a class="button secondary" href={g.href}>{g.label}</a>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    {faqItems && faqItems.length > 0 && (
      <section class="section article-faq" id="faq">
        <h2>常見問題</h2>
        <div class="faq-list">
          {faqItems.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="section cta">
      <h2>{bottomCtaH2}</h2>
      <p>{bottomCtaP}</p>
      <div class="button-row">
        {serviceLink && <a class="button secondary" href={serviceLink.href}>{serviceLink.label}</a>}
        {/* 推甄系列拿掉「回知識庫」：轉換終端只留服務＋諮詢，避免低價值選項稀釋（v3 review P0） */}
        {category !== '研究所推甄' && <a class="button secondary" href="/pages/resources.html">回知識庫</a>}
        <a class="button" href={bottomCtaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_article_bottom">預約策略諮詢</a>
      </div>
    </section>

    <section class="section">
      <h2>延伸閱讀</h2>
      <div class="card-grid">
        {relatedArticles.map(a => (
          <article class="card article-card">
            <span class="badge">{a.badge}</span>
            <h3><a class="text-link" href={a.href}>{a.title}</a></h3>
            <p class="card-desc">{a.desc}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  {/* 手機目錄 FAB：長文捲到中段也能開目錄跳段（桌面由 sticky 側欄涵蓋，CSS 隱藏本元件） */}
  {tocItems.length > 0 && (
    <div class="toc-fab-wrap">
      <div class="toc-fab-panel" id="toc-fab-panel" hidden>
        <div class="toc-fab-head">本文目錄</div>
        <nav>
          {tocItems.map(item => (
            <a href={item.href} class="toc-fab-link">{item.label}</a>
          ))}
        </nav>
      </div>
      <button type="button" class="toc-fab" id="toc-fab" aria-expanded="false" aria-controls="toc-fab-panel">☰ 目錄</button>
    </div>
  )}
  <script>
    // 只取文章目錄內的錨點連結。.pg-sidebar-link 也被 series-rail 共用，
    // 但那些連結的 href 是完整路徑（/pages/...），丟進 querySelector 會拋
    // SyntaxError 並中斷整段腳本（連帶讓目錄展開按鈕失效），故限縮在 .article-toc。
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.article-toc .pg-sidebar-link'));
    const sections = tocLinks
      .map(a => document.querySelector(a.getAttribute('href') ?? ''))
      .filter((el): el is Element => el !== null);

    // 手機版目錄收合（桌面版一律展開，按鈕以 CSS 隱藏）
    const toc = document.querySelector('.article-toc');
    const tocToggle = document.getElementById('article-toc-toggle');
    const tocToggleText = tocToggle?.querySelector('.pg-guide-toggle-text');
    const setTocOpen = (open: boolean) => {
      toc?.classList.toggle('open', open);
      tocToggle?.setAttribute('aria-expanded', String(open));
      if (tocToggleText) tocToggleText.textContent = open ? '收起' : '展開';
    };
    tocToggle?.addEventListener('click', () => setTocOpen(!toc?.classList.contains('open')));
    // 點目錄連結跳轉後自動收起（僅手機）
    const isMobile = () => window.matchMedia('(max-width: 1023px)').matches;
    tocLinks.forEach(a => a.addEventListener('click', () => { if (isMobile()) setTocOpen(false); }));

    // 手機目錄 FAB：開合面板（點外部、Esc、點連結皆關閉）
    const fab = document.getElementById('toc-fab');
    const fabPanel = document.getElementById('toc-fab-panel');
    const fabLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-fab-link'));
    const setFabOpen = (open: boolean) => {
      if (!fab || !fabPanel) return;
      fabPanel.hidden = !open;
      fab.setAttribute('aria-expanded', String(open));
    };
    fab?.addEventListener('click', (e) => { e.stopPropagation(); setFabOpen(!!fabPanel?.hidden); });
    fabPanel?.addEventListener('click', (e) => e.stopPropagation());
    fabLinks.forEach(a => a.addEventListener('click', () => setFabOpen(false)));
    document.addEventListener('click', () => setFabOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setFabOpen(false); });

    const observer = new IntersectionObserver(entries => {
      const visible = entries.find(e => e.isIntersecting);
      if (!visible) return;
      [...tocLinks, ...fabLinks].forEach(a => a.classList.remove('active'));
      document.querySelectorAll<HTMLAnchorElement>(`.pg-sidebar-link[href="#${visible.target.id}"], .toc-fab-link[href="#${visible.target.id}"]`)
        .forEach(l => l.classList.add('active'));
    }, { rootMargin: '-10% 0px -60% 0px', threshold: 0 });

    sections.forEach(s => observer.observe(s));
  </script>
</BaseLayout>
