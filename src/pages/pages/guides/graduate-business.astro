---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';
import { templatesFor, gradGuideByDept } from '../../../config/gradTemplates';

// 商管與財經類群研究所申請路徑：通用階段「重用」既有研究所推甄文章，
// 只有商管財經真正不同的環節（整合期時程、選校所定位、可研究的問題、商業故事線備審、綜合能力口試）用商管專屬文。
const STAGE_ORDER = [
  { slug: 'graduate-recommend-vs-exam',   tag: '通用',   role: '先理解推甄與考試的差異；商管財經的路線判斷基準見下方快篩。' },
  { slug: 'business-graduate-timeline',   tag: '商管專屬', role: '問題不是沒經歷，而是經歷太零散——大三下到大四上是整合與輸出期，不是從零創造期。' },
  { slug: 'business-graduate-choose',     tag: '商管專屬', role: '名稱相似的系所可能完全不同：用定位、教授方向、職涯出口三層收斂名單。' },
  { slug: 'graduate-contact-professor',   tag: '通用',   role: '送件前聯繫教授；商管財經要多做的幾件事，直達文內〈商管與財經專屬重點〉。', anchor: '#business-tips' },
  { slug: 'business-graduate-proposal',   tag: '商管專屬', role: '把熱門議題變成可研究的問題：現象→對象→變數→關係→方法，五步收斂。' },
  { slug: 'business-graduate-cv',         tag: '商管專屬', role: '用 CV、自傳與商業故事線，把零散的實習、競賽與專題整合成一條主線。' },
  { slug: 'business-graduate-oral',       tag: '商管專屬', role: '綜合能力測試：研究計畫、專業科目、財經時事與個案題，用框架撐住結構。' },
];

const bySlug = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.slug, a])
);
const stages = STAGE_ORDER
  .map((s, i) => {
    const a = bySlug[s.slug];
    if (!a) return null;
    // anchor：通用文內的商管專屬區塊（#business-tips），總覽直接深連結到該段
    return { n: i + 1, tag: s.tag, role: s.role, title: a.data.title, href: `/pages/resources/${a.slug}.html${'anchor' in s && s.anchor ? s.anchor : ''}` };
  })
  .filter(Boolean);

// 可下載模板（實體檔在 public/assets/templates/，各對應一篇專屬文）
// 可下載模板：資料在 src/config/gradTemplates.ts（與 resources/tools.html 同一份來源）
const templates = templatesFor('商管財經');

const title = gradGuideByDept['商管財經'].pageTitle;
const description = '商管財經研究所推甄怎麼準備？這個指南依申請順序拆成七個階段——從推甄與考試的路線判斷、把經歷整合成主線的時程規劃，到商管財經專屬的選校所定位、可研究的問題、商業故事線備審與綜合能力口試，並附五份可下載模板。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-graduate-business`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/graduate-business.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "ItemList",
      "name": "商管與財經研究所申請的七個階段",
      "itemListElement": stages.map((s) => ({
        "@type": "ListItem",
        "position": s.n,
        "name": s.title,
        "item": `${site.siteUrl}${s.href}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/graduate-business.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南 · 商管與財經類群</span>
  <h1>{title}</h1>
  <p class="lead">商管財經推甄和其他領域最大的不同，是學生卡住的原因通常不是「沒有經歷」，而是實習、競賽、社團與專題各做各的，拼不成一條線；加上校名與系排的影響更直接、口試常同時檢驗專業科目、財經時事與個案分析，材料到處投的命中率會明顯下降。這個指南把申請拆成七個階段，和通用的研究所推甄指南同一套骨架：推甄與考試、聯繫教授沿用通用文章，商管財經真正不同的環節（整合期時程、選校所定位、可研究的問題、商業故事線備審、綜合能力口試）則有專屬深文，並附五份可直接下載的模板。建議照順序讀一遍，再回頭把卡住的階段讀深。</p>
</section>

<main>

  <section class="section" id="route-check">
    <h2>先做路線快篩：推甄、考試還是並行？</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">投入七個階段之前，先確認方向。以顧問經驗，商管財經學生可以依目標校所層級與系排做第一層參考（是參考基準，不是絕對門檻）：</p>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">目標：頂尖商管財經校所</span>
        <h3>前段背景＋系排前 15%：推甄為主</h3>
        <p class="card-desc">具備明確實習、競賽或研究成果與良好英文能力者，推甄為主、考試為輔。系排中段但有明顯亮點，則精準投遞加考試並行。</p>
      </article>
      <article class="card article-card">
        <span class="badge">目標：中段國立與科大商管</span>
        <h3>系排前 5%～25%：積極推甄</h3>
        <p class="card-desc">經歷合理即可積極投入。排名較後仍可依校系特性、跨領域背景與個人亮點精準投遞，但主要筆試準備應保留。</p>
      </article>
      <article class="card article-card">
        <span class="badge">缺前段排名與突出經歷</span>
        <h3>以考試為主，推甄精準投遞</h3>
        <p class="card-desc">實習、競賽、專案或清楚職涯方向——有這些亮點才值得認真投入推甄；否則務實投入一般考試，避免兩頭空。</p>
      </article>
    </div>
    <p style="margin-top: 16px; color: var(--tbd-mid);">系排之外的第二層檢核（經歷能不能整合成一條主線、能不能同時維持備審與筆試進度），見<a class="text-link" href="/pages/resources/business-graduate-timeline.html">商管與財經推甄時程</a>的路線判斷一節。</p>
  </section>

  <section class="section" id="stages">
    <h2>商管與財經研究所申請的七個階段</h2>
    <div class="guide-rail-legend">
      <span><i class="own"></i>商管與財經專屬深文</span>
      <span><i class="reuse"></i>沿用通用文章</span>
    </div>
    <div class="guide-rail">
      {stages.map((s) => (
        <a class={`rail-stage${s.tag !== '通用' ? ' own' : ''}`} href={s.href}>
          <span class="rs-num">{s.n}</span>
          <span class="rs-node"><i></i></span>
          <span class="rs-body">
            <span class="rs-tag">{s.tag}</span>
            <span class="rs-title">{s.title}</span>
            <span class="rs-role">{s.role}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="templates">
    <h2>商管與財經推甄專屬工具包</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">五份對應各階段的工具，兩種格式任選：<strong>CSV</strong> 用 Excel / Google 試算表開；<strong>Markdown</strong> 可一鍵匯入 Notion。</p>
    <div class="card-grid">
      {templates.map((t) => (
        <article class="card article-card">
          <span class="badge">模板</span>
          <h3>{t.title}</h3>
          <p class="card-desc">{t.desc}</p>
          <div class="button-row" style="margin-top: 16px;">
            <a class="button" href={t.md} download data-track-event="download_resource">Notion / Markdown</a>
            <a class="button secondary" href={t.csv} download data-track-event="download_resource">CSV 試算表</a>
          </div>
          <p style="margin-top: 10px;"><a class="text-link" href={t.article}>看使用說明 →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="more">
    <h2>延伸與案例</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">成功案例</span>
        <h3><a class="text-link" href="/pages/cases.html">TBD Studio 升學輔導案例</a></h3>
        <p class="card-desc">去識別化的真實案例——素材盤點、敘事重構與模擬面試怎麼落實成錄取結果，跨域申請者也適用。</p>
      </article>
      <article class="card article-card">
        <span class="badge">通用指南</span>
        <h3><a class="text-link" href="/pages/guides/graduate-application.html">研究所推甄完整指南</a></h3>
        <p class="card-desc">不分科系的研究所推甄通用流程，想先掌握整體再回到商管財經專屬準備，從這裡開始。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>商管財經推甄的經歷主線、校所名單與研究計畫，想找人一起盤點？</h2>
    <p>TBD 的策略諮詢會依你的系排現況、實習與競賽累積和目標校所，幫你判斷推甄與考試的路線配比、把零散經歷整理成可被追問的主線，並檢視研究計畫的問題意識與可行性，找出目前最該補強的階段。</p>
    <p class="cta-trust"><span>✓ 線上進行</span><span>✓ 不代寫</span><span>✓ 過程文件可追蹤</span></p>
    <div class="button-row">
      <a class="button secondary" href="/pages/services/graduate.html">看研究所推甄服務</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_graduate_business">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
