---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="TBD Studio | 讓選擇變清楚，讓路徑可驗收 - 專業升學顧問" description="TBD Studio 協助學生進行志向探索、申請策略、備審面試與歷程規劃。" bodyClass="home-page">
<!-- HERO -->
  <header class="relative pt-24 sm:pt-28 lg:pt-44 pb-14 lg:pb-28 bg-gradient-to-b from-white to-tbd-light/55 overflow-hidden">
    <!-- Shape language: triangle + circle + line (low opacity, cool tone) -->
    <div class="absolute -top-12 -right-10 opacity-[0.10] pointer-events-none">
      <svg width="560" height="560" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <polygon points="55,5 95,85 20,92" fill="#1A5D94"/>
        <circle cx="28" cy="30" r="10" fill="#767995"/>
        <path d="M10 70 L90 55" stroke="#142143" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
      </svg>
    </div>

    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-12">
        <div class="lg:w-1/2 space-y-5 sm:space-y-6">

          <!-- Badge: wrap-friendly -->
          <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-tbd-mid/30 bg-white/70 px-4 py-2 text-xs sm:text-sm">
            <span class="text-tbd-dark font-medium">志向探索 × 申請策略 × 備審／面試 × 歷程規劃</span>
          </div>
          <p class="mt-1 text-xs text-tbd-mid/70 font-bold tracking-wider">Define, Design, Deliver Your Next Move.</p>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-snug text-tbd-dark">
            把零散經歷，<br>
            整理成教授<span class="text-tbd-accent">看得懂的申請策略</span>
          </h1>

          <h2 class="text-base sm:text-lg lg:text-xl text-tbd-mid font-medium leading-relaxed">
            TBD Studio 協助學生完成方向判斷、備審重構、面試訓練與 Portfolio 主線整理，<br class="hidden sm:block">
            讓每一步準備都可追蹤、可驗收。
          </h2>

          <!-- CTAs: stack on mobile -->
          <div class="pt-2">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <a href="#cases"
                 class="inline-flex items-center justify-center border border-tbd-light/80 bg-white px-6 sm:px-8 py-3 rounded-full text-base sm:text-lg font-medium text-tbd-dark hover:opacity-90 transition">
                先看成功案例
              </a>
              <a href="#contact"
                 class="inline-flex items-center justify-center bg-tbd-accent text-white px-6 sm:px-8 py-3 rounded-full text-base sm:text-lg font-medium hover:opacity-90 transition shadow-soft">
                預約策略諮詢 →
              </a>
            </div>
            <p class="mt-2 text-xs sm:text-sm text-tbd-mid">* 付費諮詢費用可全額折抵後續方案</p>
          </div>
        </div>

        <div class="lg:w-1/2 w-full">
          <div class="relative">
            <div class="absolute -inset-2 rounded-xl bg-gradient-to-br from-tbd-accent/15 to-tbd-yellow/15 blur-2xl opacity-60"></div>

            <!-- Hero Visual: TBD Landing Page Banner -->
            <div class="relative rounded-xl shadow-soft w-full aspect-[4/3] bg-white overflow-hidden border border-tbd-light/70">
              <img
                src="/assets/images/TBD_Landing Page Banner.png"
                alt="TBD Studio 升學策略顧問首頁視覺主圖"
                class="w-full h-full object-contain object-center bg-white"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              >
            </div>

            <!-- Overlay: auto-wrap + mobile spacing -->
            <div class="absolute bottom-3 sm:bottom-4 left-3 sm:left-4 right-3 sm:right-4 bg-white/75 backdrop-blur rounded-lg p-3 sm:p-4 border border-tbd-light/70">
              <p class="text-xs sm:text-sm font-semibold text-tbd-dark">
                交付物可驗收 · 進度可追蹤 · 版本可回溯
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- PAIN POINTS -->
  <section id="pain" class="py-14 sm:py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 max-w-5xl text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-10 lg:mb-12 text-tbd-dark">你是否也面臨這樣的升學焦慮？</h2>

      <div class="grid md:grid-cols-3 gap-6 sm:gap-8 text-left">
        <!-- card (reordered: 意見分歧 first) -->
        <div class="bg-white p-6 sm:p-8 rounded-xl border border-tbd-light/80 shadow-soft">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2 h-2 rounded-full bg-tbd-accent"></span>
            <h3 class="text-lg sm:text-xl font-bold">意見分歧，決策困難</h3>
          </div>
          <p class="text-tbd-mid text-sm sm:text-base">
            親子對科系的期待常有落差；面對升學，又難以摸透校系招生偏好。此時，正需要客觀的第三方專業視角來協助釐清盲點。
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-xl border border-tbd-light/80 shadow-soft">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2 h-2 rounded-full bg-tbd-accent"></span>
            <h3 class="text-lg sm:text-xl font-bold">經歷豐富，卻無法聚焦</h3>
          </div>
          <p class="text-tbd-mid text-sm sm:text-base">
            獎狀、營隊寫得滿滿滿，卻拼湊不出一個立體的「人」？別讓孩子的真實熱情與天賦，被淹沒在毫無記憶點的清單裡。
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-xl border border-tbd-light/80 shadow-soft">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2 h-2 rounded-full bg-tbd-accent"></span>
            <h3 class="text-lg sm:text-xl font-bold">成績優異，卻缺乏故事</h3>
          </div>
          <p class="text-tbd-mid text-sm sm:text-base">
            學科頂尖只是基本的入場券！若沒有引人入勝的專屬敘事，即使成績傲人，也怕在海量的優秀名單中失去亮點、黯然失色。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST / DELIVERABLES -->
  <section id="deliverables" class="py-14 sm:py-16 lg:py-20 bg-tbd-light/40">
    <div class="container mx-auto px-4 sm:px-6 max-w-5xl">
      <div class="text-center mb-10 sm:mb-12">
        <span class="inline-flex items-center rounded-full border border-tbd-light/80 bg-tbd-accent/10 px-3 py-1 text-xs font-bold text-tbd-accent">我們如何協助學生</span>
        <h2 class="mt-4 text-2xl sm:text-3xl font-bold text-tbd-dark">不是代寫，而是把資料整理成<br class="hidden sm:block">可被教授理解、可被面試答辯的申請系統</h2>
        <p class="mt-3 text-tbd-mid max-w-xl mx-auto">每一次合作，都會產出具體可檢視的交付物——讓你的準備有節點、有成果，而不是花了時間但說不清楚做了什麼。</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 sm:gap-6">
        <div class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-6 sm:p-7">
          <div class="w-10 h-10 rounded-lg bg-tbd-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tbd-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-tbd-dark mb-2">申請策略診斷報告</h3>
          <p class="text-tbd-mid text-sm leading-relaxed">初談後產出一份文件，說明你目前的競爭力定位、最適合的升學管道、以及建議的準備優先順序。是整個申請系統的起點。</p>
        </div>

        <div class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-6 sm:p-7">
          <div class="w-10 h-10 rounded-lg bg-tbd-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tbd-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10M4 18h6"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-tbd-dark mb-2">經歷素材盤點表</h3>
          <p class="text-tbd-mid text-sm leading-relaxed">系統化整理你的競賽、課程、專題、幹部、實習與自學成果，標記每項素材的申請價值與可延伸方向，讓備審撰寫有材料可用。</p>
        </div>

        <div class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-6 sm:p-7">
          <div class="w-10 h-10 rounded-lg bg-tbd-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tbd-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-3 3-3-3z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-tbd-dark mb-2">面試題庫與模擬回饋</h3>
          <p class="text-tbd-mid text-sm leading-relaxed">依照你的科系與備審內容客製化面試題庫，涵蓋自我介紹、動機題、專業題與追問預測，並附上每次模擬面試的結構化回饋報告。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES BY CHANNEL -->
  <section class="py-12 sm:py-14 bg-tbd-light/30">
    <div class="container mx-auto px-4 sm:px-6 max-w-5xl">
      <div class="text-center mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-tbd-dark">依你的升學管道找到對應服務</h2>
        <p class="mt-2 text-tbd-mid text-sm">選擇你的準備階段，了解 TBD 具體如何協助。</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/pages/services/college-application.html" class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-5 hover:border-tbd-accent/40 hover:shadow-md transition group" style="text-decoration: none;">
          <div class="text-xs font-bold text-tbd-accent bg-tbd-accent/10 rounded-full px-2 py-1 inline-block mb-3">個人申請</div>
          <h3 class="font-bold text-tbd-dark text-sm leading-snug">個人申請備審整理與輔導</h3>
          <p class="mt-2 text-xs text-tbd-mid leading-relaxed">素材盤點、主線建立、文件重構</p>
        </a>
        <a href="/pages/services/special-admission.html" class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-5 hover:border-tbd-accent/40 hover:shadow-md transition group" style="text-decoration: none;">
          <div class="text-xs font-bold text-tbd-accent bg-tbd-accent/10 rounded-full px-2 py-1 inline-block mb-3">特殊選才</div>
          <h3 class="font-bold text-tbd-dark text-sm leading-snug">特殊選才申請策略與備審輔導</h3>
          <p class="mt-2 text-xs text-tbd-mid leading-relaxed">特殊性定位、備審整理、面試答辯</p>
        </a>
        <a href="/pages/services/graduate.html" class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-5 hover:border-tbd-accent/40 hover:shadow-md transition group" style="text-decoration: none;">
          <div class="text-xs font-bold text-tbd-accent bg-tbd-accent/10 rounded-full px-2 py-1 inline-block mb-3">研究所推甄</div>
          <h3 class="font-bold text-tbd-dark text-sm leading-snug">研究所推甄備審與研究計畫輔導</h3>
          <p class="mt-2 text-xs text-tbd-mid leading-relaxed">研究計畫書、學術自傳、口試準備</p>
        </a>
        <a href="/pages/services/interview-training.html" class="bg-white rounded-xl border border-tbd-light/80 shadow-soft p-5 hover:border-tbd-accent/40 hover:shadow-md transition group" style="text-decoration: none;">
          <div class="text-xs font-bold text-tbd-accent bg-tbd-accent/10 rounded-full px-2 py-1 inline-block mb-3">面試訓練</div>
          <h3 class="font-bold text-tbd-dark text-sm leading-snug">個人申請二階面試訓練</h3>
          <p class="mt-2 text-xs text-tbd-mid leading-relaxed">客製化題庫、模擬面試、結構化回饋</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section id="cases" class="py-14 sm:py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <div class="mb-8 sm:mb-10 lg:mb-12">
        <span class="inline-flex items-center rounded-full border border-tbd-light/80 bg-tbd-accent/10 px-3 py-1 text-xs font-bold text-tbd-accent">成功案例</span>
        <h2 class="mt-4 text-2xl sm:text-3xl font-bold text-tbd-dark">讓學生的故事，成為被錄取的理由</h2>
        <p class="mt-3 text-tbd-mid max-w-2xl">以下案例已去識別化處理，保留真實合作脈絡、交付方法與成果，避免揭露學生個資。</p>
      </div>

      <div class="grid lg:grid-cols-[1.25fr_0.75fr] gap-6 sm:gap-8 items-stretch">
        <article class="relative overflow-hidden rounded-2xl border border-tbd-light/80 bg-white shadow-soft">
          <div class="absolute -right-16 -top-16 w-56 h-56 rounded-full bg-tbd-accent/10"></div>
          <div class="absolute right-10 top-12 w-24 h-24 rounded-full bg-tbd-yellow/20"></div>
          <div class="relative grid md:grid-cols-[0.9fr_1.1fr] min-h-[360px]">
            <div class="bg-tbd-dark p-6 sm:p-8 text-white flex flex-col justify-between gap-8">
              <div>
                <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/10 px-3 py-1 text-xs font-bold text-tbd-yellow">特殊選才｜機械工程組</div>
                <h3 class="mt-5 text-2xl sm:text-3xl font-bold leading-snug">從競賽型學生，到能說清楚研究動機的工程申請者</h3>
              </div>
              <div class="grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-xl bg-white/8 border border-white/10 p-4">
                  <div class="text-white/45 text-[11px] uppercase tracking-widest">Period</div>
                  <div class="mt-1 font-bold">約 20 週</div>
                </div>
                <div class="rounded-xl bg-white/8 border border-white/10 p-4">
                  <div class="text-white/45 text-[11px] uppercase tracking-widest">Mode</div>
                  <div class="mt-1 font-bold">視訊＋文件協作</div>
                </div>
                <div class="rounded-xl bg-white/8 border border-white/10 p-4 col-span-2">
                  <div class="text-white/45 text-[11px] uppercase tracking-widest">Result</div>
                  <div class="mt-1 font-bold text-tbd-yellow">錄取陽明交通大學百川學士學位學程</div>
                </div>
              </div>
            </div>

            <div class="p-6 sm:p-8 flex flex-col justify-between gap-6">
              <div>
                <div class="flex flex-wrap gap-2 mb-4">
                  <span class="text-[11px] font-bold text-tbd-accent bg-tbd-accent/10 px-2 py-1 rounded">VEX 世界賽代表</span>
                  <span class="text-[11px] font-bold text-tbd-accent bg-tbd-accent/10 px-2 py-1 rounded">機電自學</span>
                  <span class="text-[11px] font-bold text-tbd-accent bg-tbd-accent/10 px-2 py-1 rounded">跨域工程動機</span>
                </div>
                <p class="text-tbd-mid text-sm sm:text-base leading-relaxed">
                  學生原本有豐富競賽與跨域素材，但主線發散、面試表達容易只停在成果陳述。TBD 透過競爭力定位、素材庫盤點、SARI 敘事架構與模擬面試覆盤，協助他把「做過很多事」轉化為「我為什麼適合這個學程」。
                </p>
              </div>
              <div class="grid sm:grid-cols-3 gap-3">
                <div class="rounded-xl border border-tbd-light/80 bg-tbd-light/25 p-4">
                  <div class="text-xs font-bold text-tbd-accent">01 定位</div>
                  <p class="mt-2 text-sm text-tbd-mid">用強度金字塔釐清競賽含金量與申請落點。</p>
                </div>
                <div class="rounded-xl border border-tbd-light/80 bg-tbd-light/25 p-4">
                  <div class="text-xs font-bold text-tbd-accent">02 敘事</div>
                  <p class="mt-2 text-sm text-tbd-mid">把挫敗、工具、競賽整合成工程主線。</p>
                </div>
                <div class="rounded-xl border border-tbd-light/80 bg-tbd-light/25 p-4">
                  <div class="text-xs font-bold text-tbd-accent">03 面試</div>
                  <p class="mt-2 text-sm text-tbd-mid">用邏輯拆解取代背稿，預先覆蓋追問。</p>
                </div>
              </div>
              <a href="/pages/cases.html#case-special-admission" class="inline-flex items-center justify-center bg-tbd-accent text-white px-5 py-3 rounded-md text-sm font-bold hover:opacity-90 transition shadow-soft">
                閱讀案例拆解 →
              </a>
            </div>
          </div>
        </article>

        <aside class="flex flex-col">
          <article class="flex-1 overflow-hidden rounded-2xl border border-tbd-light/80 bg-white shadow-soft p-6 sm:p-7 flex flex-col justify-between gap-5">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-tbd-accent/10 border border-tbd-accent/20 px-3 py-1 text-xs font-bold text-tbd-accent mb-4">大學個人申請｜機械工程組</div>
              <h3 class="text-xl font-bold text-tbd-dark leading-snug">從樂高到機器人競賽，整合成中原機械的入學論述</h3>
              <p class="mt-3 text-sm text-tbd-mid leading-relaxed">學生有豐富競賽資歷，但主線發散、工程價值說不清楚。TBD 協助建立「樂高→機器人→醫療應用→汽車設計」成長敘事，並以逐字稿修正強化面試口條。</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="text-[11px] font-bold text-tbd-accent bg-tbd-accent/10 px-2 py-1 rounded">國際機器人大賽</span>
              <span class="text-[11px] font-bold text-tbd-accent bg-tbd-accent/10 px-2 py-1 rounded">程式設計自學</span>
              <span class="text-[11px] font-bold text-tbd-accent bg-tbd-accent/10 px-2 py-1 rounded">醫療機器人跨域</span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="rounded-xl bg-tbd-light/50 border border-tbd-light/80 p-3">
                <div class="text-tbd-mid/60 text-[10px] uppercase tracking-widest">Period</div>
                <div class="mt-1 font-bold text-tbd-dark">約 24 週</div>
              </div>
              <div class="rounded-xl bg-tbd-accent/5 border border-tbd-accent/20 p-3">
                <div class="text-tbd-mid/60 text-[10px] uppercase tracking-widest">Result</div>
                <div class="mt-1 font-bold text-tbd-dark text-xs">中原大學<br>機械工程學系</div>
              </div>
            </div>
            <a href="/pages/cases.html" class="inline-flex items-center justify-center border border-tbd-accent text-tbd-accent px-4 py-2.5 rounded-md text-sm font-bold hover:bg-tbd-accent hover:text-white transition">
              閱讀案例拆解 →
            </a>
          </article>
        </aside>
      </div>
    </div>
  </section>

  <!-- VALUES / METHOD -->
<section id="method" class="py-16 sm:py-20 lg:py-24 bg-tbd-dark text-white relative overflow-hidden">
    <div class="absolute -bottom-24 -left-20 opacity-[0.1] pointer-events-none rotate-12">
      <svg width="600" height="600" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="#767995"/>
        <path d="M15 55 L85 45" stroke="#FAB748" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
        <polygon points="70,10 95,70 45,82" fill="#1A5D94"/>
      </svg>
    </div>

    <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
      <div class="text-center mb-12 lg:mb-20">
        <h2 class="text-2xl sm:text-4xl font-bold mb-6 tracking-tight">
