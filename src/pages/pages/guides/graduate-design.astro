---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';

// 設計類群研究所申請路徑：通用階段「重用」既有研究所推甄文章，
// 只有設計真正不同的環節（選校型態、研究計畫×作品集、口試講評）用設計專屬文。
const STAGE_ORDER = [
  { slug: 'graduate-recommend-vs-exam', tag: '通用',   role: '先理解推甄與考試的差異——設計領域多以推甄／申請為主。' },
  { slug: 'graduate-timeline',          tag: '通用',   role: '把大三下到大四上的關鍵節點排進時程。' },
  { slug: 'design-graduate-choose',     tag: '設計專屬', role: '分清學術型與實務型，依師資與作品方向選校選教授。' },
  { slug: 'graduate-contact-professor', tag: '通用',   role: '送件前聯繫教授：套磁信怎麼寫、什麼時候寄。' },
  { slug: 'design-graduate-proposal',   tag: '設計專屬', role: '把模糊的設計興趣，收斂成一個值得做的研究計畫。' },
  { slug: 'design-graduate-portfolio',  tag: '設計專屬', role: '作品集怎麼選件、排序、說明，並支撐你的研究計畫。' },
  { slug: 'design-graduate-oral',       tag: '設計專屬', role: '為作品答辯、面對講評，準備設計口試的現場對話。' },
];

const bySlug = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.slug, a])
);
const stages = STAGE_ORDER
  .map((s, i) => {
    const a = bySlug[s.slug];
    if (!a) return null;
    return { n: i + 1, tag: s.tag, role: s.role, title: a.data.title, href: `/pages/resources/${a.slug}.html` };
  })
  .filter(Boolean);

const title = '設計研究所申請完整指南';
const description = '設計研究所怎麼準備？這個指南依申請順序拆成七個階段——從推甄與考試、時程規劃，到設計專屬的選校（學術型vs實務型）、聯繫教授、研究計畫、作品集，以及口試與作品集講評。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-graduate-design`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/graduate-design.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "ItemList",
      "name": "設計研究所申請的七個階段",
      "itemListElement": stages.map((s) => ({
        "@type": "ListItem",
        "position": s.n,
        "name": s.title,
        "item": `${site.siteUrl}${s.href}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/graduate-design.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南 · 設計類群</span>
  <h1>{title}</h1>
  <p class="lead">設計研究所和其他領域不同——同樣是碩士，有學術型與實務型之分，作品集的份量也比多數學門更重。這個指南把申請拆成七個階段，和通用的研究所推甄指南同一套骨架：通用的時程與套磁沿用研究所推甄文章，設計真正不同的環節（選校型態、研究計畫、作品集、口試講評）則有設計專屬深文。建議照順序讀一遍，再回頭把卡住的階段讀深。</p>
</section>

<main>

  <section class="section" id="stages">
    <h2>設計研究所申請的七個階段</h2>
    <div class="guide-rail-legend">
      <span><i class="own"></i>設計專屬深文</span>
      <span><i class="reuse"></i>沿用通用文章</span>
    </div>
    <div class="guide-rail">
      {stages.map((s) => (
        <a class={`rail-stage${s.tag !== '通用' ? ' own' : ''}`} href={s.href}>
          <span class="rs-num">{s.n}</span>
          <span class="rs-node"><i></i></span>
          <span class="rs-body">
            <span class="rs-tag">{s.tag}</span>
            <span class="rs-title">{s.title}</span>
            <span class="rs-role">{s.role}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="more">
    <h2>延伸與案例</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">成功案例</span>
        <h3><a class="text-link" href="/pages/cases.html">TBD Studio 升學輔導案例（含研究所申請）</a></h3>
        <p class="card-desc">去識別化的真實案例，看學生如何完成素材盤點、備審重構與面試訓練，把這些階段落實成錄取結果。</p>
      </article>
      <article class="card article-card">
        <span class="badge">通用指南</span>
        <h3><a class="text-link" href="/pages/guides/graduate-application.html">研究所推甄完整指南</a></h3>
        <p class="card-desc">不分科系的研究所推甄通用流程，想先掌握整體再回到設計專屬準備，從這裡開始。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>設計研究所的選校、研究計畫與作品集，想找人一起盤點？</h2>
    <p>TBD 的策略諮詢會依你的設計方向、作品累積與目標校系，幫你檢視學術／實務路線、選校名單與研究計畫和作品集的整合，找出目前最該補強的階段。線上進行、不代寫，過程文件可追蹤。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_graduate_design">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
