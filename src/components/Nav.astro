---
import { nav, site } from '../config/site';
const currentPath = Astro.url.pathname;
const navCta = `${site.lineUrl}?utm_source=website&utm_medium=nav&utm_campaign=nav-cta`;

function isActive(item: { id: string; href: string }) {
  if (currentPath === item.href) return true;
  if (item.id === 'resources') return currentPath.includes('/resources');
  if (item.id !== 'home') return currentPath.startsWith(item.href.replace('.html', ''));
  return false;
}
---

<header class="site-header">
  <nav class="site-nav" aria-label="主要導覽">
    <a class="site-logo" href="/index.html" aria-label="TBD Studio 官方首頁">
      <img src={site.logoUrl} alt="TBD Studio Logo" width="168" height="44">
    </a>

    <div class="site-nav-links" aria-label="桌面導覽">
      {nav.map(item => (
        <a
          href={item.href}
          class={isActive(item) ? 'is-active' : ''}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </div>

    <div class="site-nav-actions">
      <a class="site-nav-cta site-nav-cta--mobile" href={navCta} data-track-event="click_consultation_cta" data-ga-event="click_line_nav">策略諮詢</a>
      <a class="site-nav-cta site-nav-cta--desktop" href={navCta} data-track-event="click_consultation_cta" data-ga-event="click_line_nav">預約策略諮詢 →</a>

      <details class="site-menu" id="mobileMenu">
        <summary class="site-menu-button" aria-label="開啟導覽選單">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </summary>
        <div class="site-menu-backdrop" data-menu-backdrop></div>
        <div class="site-menu-panel">
          <div class="site-menu-head">
            <div class="site-menu-title">快速導覽</div>
            <button type="button" class="site-menu-close" data-close-menu aria-label="關閉導覽選單">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <div class="site-menu-links">
            {nav.map(item => (
              <a href={item.href} data-menu-link>{item.label}</a>
            ))}
            <a class="site-menu-cta" href={navCta} data-menu-link data-track-event="click_consultation_cta" data-ga-event="click_line_menu">預約策略諮詢 →</a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
