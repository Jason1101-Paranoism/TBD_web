---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';

const title = 'Side Project 升學完整指南';
const description = 'Side Project 是現行申請制度下最有說服力的能力證明之一。這個頁面收錄 TBD Studio 的 Side Project 系列文章：從為什麼它越來越重要，到選題、執行與競賽延伸，完整涵蓋每個環節。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-side-project`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/side-project.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/side-project.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南</span>
  <h1>{title}</h1>
  <p class="lead">Side Project 是現行申請制度下最有說服力的能力證明之一。這個頁面收錄 TBD Studio 所有 Side Project 相關文章，從觀念建立、選題思路、執行流程，到競賽延伸與隊友尋找，完整涵蓋你需要的每一個環節。</p>
</section>

<main>

  <section class="section" id="why">
    <h2>為什麼 Side Project 在升學中越來越重要？</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">Side Project</span>
        <h3><a class="text-link" href="/pages/resources/side-project-why.html">為什麼升學越來越重視 Side Project？</a></h3>
        <p class="card-desc">主動發起的專案，是成績無法替代的能力證明。了解 Side Project 在台灣升學中的實際定位。</p>
      </article>

      <article class="card article-card">
        <span class="badge">Side Project</span>
        <h3><a class="text-link" href="/pages/resources/side-project-ai-era.html">AI 時代為什麼 Side Project 越來越重要？</a></h3>
        <p class="card-desc">頂尖大學升學邏輯的根本轉變、AI 時代真正稀缺的能力，以及 Side Project 如何成為可驗證的能力證明。</p>
      </article>

    </div>
  </section>

  <section class="section" id="how">
    <h2>如何選題、開始、做到完成</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">Side Project</span>
        <h3><a class="text-link" href="/pages/resources/side-project-types.html">高中生可以做哪些 Side Project？五大類型與科系對照</a></h3>
        <p class="card-desc">五大類型的作品方向、不同科系適合的選擇，以及什麼樣的 Side Project 真正有說服力。</p>
      </article>

      <article class="card article-card">
        <span class="badge">Side Project</span>
        <h3><a class="text-link" href="/pages/resources/side-project-start.html">Side Project 可以怎麼開始？如何從科系方向反推專案主題？</a></h3>
        <p class="card-desc">為什麼學生卡在選題、各科系的反推思路，以及如何做出第一個可以展示的版本。</p>
      </article>

      <article class="card article-card">
        <span class="badge">Side Project</span>
        <h3><a class="text-link" href="/pages/resources/side-project-from-zero.html">從 0 到 1：Side Project 從題目到成果的完整流程</a></h3>
        <p class="card-desc">定義問題、縮小範圍、做出第一版、優化、整理展示——五個階段讓專案真正做得完。</p>
      </article>

    </div>
  </section>

  <section class="section" id="extend">
    <h2>把競賽、Hackathon 延伸成 Side Project</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">競賽策略</span>
        <h3><a class="text-link" href="/pages/resources/competition-to-project.html">如何把競賽延伸成長期專案？</a></h3>
        <p class="card-desc">競賽結束後，大多數人什麼都沒留下。三種把競賽成果轉化成長期主線的具體方式。</p>
      </article>

      <article class="card article-card">
        <span class="badge">競賽指南</span>
        <h3><a class="text-link" href="/pages/resources/hackathon-guide.html">Hackathon 參加指南：高中生怎麼找、怎麼準備、怎麼讓它有申請價值？</a></h3>
        <p class="card-desc">台灣高中生可以參加的 Hackathon、第一次參加怎麼準備，以及讓 Hackathon 有申請價值的做法。</p>
      </article>

      <article class="card article-card">
        <span class="badge">學習策略</span>
        <h3><a class="text-link" href="/pages/resources/find-teammates.html">如何找到一起做專案的隊友？</a></h3>
        <p class="card-desc">去哪裡找、怎麼開口、合作開始後怎麼讓它持續，以及哪些人不適合一起做。</p>
      </article>

    </div>
  </section>

  <section class="section cta">
    <h2>不知道做哪種 Side Project 最適合你的科系目標？</h2>
    <p>TBD 的策略諮詢會根據你的興趣、目標科系與目前的材料狀況，幫你找到最值得投入的方向，以及如何讓它在備審中最有說服力。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_side_project">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
