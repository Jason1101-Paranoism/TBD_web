  <script>
    (function () {
      var triggers = Array.prototype.slice.call(document.querySelectorAll('.home-case-trigger'));
      var details = Array.prototype.slice.call(document.querySelectorAll('.home-case-detail'));
      if (!triggers.length) return;
      function activate(key) {
        triggers.forEach(function (t) {
          var on = t.getAttribute('data-case') === key;
          t.classList.toggle('active', on);
          t.setAttribute('aria-expanded', on ? 'true' : 'false');
        });
        details.forEach(function (d) {
          d.classList.toggle('active', d.getAttribute('data-case') === key);
        });
      }
      triggers.forEach(function (t) {
        t.addEventListener('click', function () { activate(t.getAttribute('data-case')); });
      });
    })();
  </script>

