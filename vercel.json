{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/pages/seen.html",
      "destination": "https://app.tbd-edu.com/",
      "permanent": false
    },
    {
      "source": "/pages/placement.html",
      "destination": "https://app.tbd-edu.com/placement",
      "permanent": false
    },
    {
      "source": "/pages/plans.html",
      "destination": "/pages/services.html#plans",
      "permanent": true
    },
    {
      "source": "/pages/audience.html",
      "destination": "/pages/services.html",
      "permanent": true
    },
    {
      "source": "/pages.html",
      "destination": "/pages/services.html",
      "permanent": true
    }
  ]
}
