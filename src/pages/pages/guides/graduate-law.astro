---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';
import { templatesFor, gradGuideByDept } from '../../../config/gradTemplates';

// 法政類群研究所申請路徑：通用階段「重用」既有研究所推甄文章，
// 只有法政類群真正不同的環節（大三上起跑的時程、研究取向與方法相容性選所、
// 可辯論爭點的研究計畫、專業軌跡一致的備審、立場論證與反駁答辯的口試）用法政專屬文。
const STAGE_ORDER = [
  { slug: 'graduate-recommend-vs-exam', tag: '通用',   role: '先理解推甄與考試的差異；法政類群的路線判斷基準見下方快篩。' },
  { slug: 'law-graduate-timeline',      tag: '法政專屬', role: '研究計畫、小論文、核心科目成績與推薦信都是時間差的產物——為什麼起點是大三上，以及來不及的人該怎麼取捨。' },
  { slug: 'law-graduate-choose',        tag: '法政專屬', role: '同一個系，訓練可能完全不同：從次領域、研究取向與方法相容性，一路查到教授當年度收不收生。' },
  { slug: 'graduate-contact-professor', tag: '通用',   role: '送件前聯繫教授；法政類群要用文字作品證明論證能力，判斷方式直達文內〈法政類群專屬重點〉。', anchor: '#law-tips' },
  { slug: 'law-graduate-proposal',      tag: '法政專屬', role: '不是文獻整理也不是宏大主題：把議題縮小成一個可辯論、兩年做得完的爭點。' },
  { slug: 'law-graduate-cv',            tag: '法政專屬', role: 'CV 列事實、自傳講軌跡、計畫寫未來；法服、旁聽與國會經歷怎麼變成研究能力證據。' },
  { slug: 'law-graduate-oral',          tag: '法政專屬', role: '教授提反方觀點不是要考倒你：一分鐘立場說明、四類追問題庫與被指出矛盾時的六步框架。' },
];

const bySlug = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.slug, a])
);
const stages = STAGE_ORDER
  .map((s, i) => {
    const a = bySlug[s.slug];
    if (!a) return null;
    // anchor：通用文內的法政類群專屬區塊（#law-tips），總覽直接深連結到該段
    return { n: i + 1, tag: s.tag, role: s.role, title: a.data.title, href: `/pages/resources/${a.slug}.html${'anchor' in s && s.anchor ? s.anchor : ''}` };
  })
  .filter(Boolean);

// 可下載模板：資料在 src/config/gradTemplates.ts（與 resources/tools.html 同一份來源）
const templates = templatesFor('法政');

const title = gradGuideByDept['法政'].pageTitle;
const description = '法政研究所推甄怎麼準備？這個指南依申請順序拆成七個階段——從推甄與考試的路線判斷、大三上起跑的時程規劃，到法政類群專屬的研究取向與教授選所、可辯論爭點的研究計畫、專業軌跡一致的備審，以及立場論證與反駁答辯的口試，並附五份可下載模板。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-graduate-law`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/graduate-law.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "ItemList",
      "name": "法政研究所申請的七個階段",
      "itemListElement": stages.map((s) => ({
        "@type": "ListItem",
        "position": s.n,
        "name": s.title,
        "item": `${site.siteUrl}${s.href}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/graduate-law.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南 · 法政類群</span>
  <h1>{title}</h1>
  <p class="lead">法政類群涵蓋法律、政治學、國際關係、公共行政與公共政策等方向，申請的關鍵不是熟記多少學說，而是能不能提出一個具體、可辯論且做得完的研究問題，並在推論被挑戰時維持一致。教授要從研究計畫、備審與口試中判斷的，是你有沒有能力把課堂表現、文字作品與實務經歷，整合成一條清楚且答辯得了的研究路線。這個指南把申請拆成七個階段，和通用的研究所推甄指南同一套骨架：推甄與考試、聯繫教授沿用通用文章，法政類群真正不同的環節（大三上起跑的時程、研究取向與方法相容性選所、可辯論爭點的研究計畫、專業軌跡一致的備審、立場論證與反駁答辯的口試）則有專屬深文，並附五份可直接下載的模板。建議照順序讀一遍，再回頭把卡住的階段讀深。</p>
</section>

<main>

  <section class="section" id="route-check">
    <h2>先做路線快篩：推甄、考試還是並行？</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">投入七個階段之前，先確認方向。法政類群的推甄與考試檢驗的是兩種不同的能力——建議用三個問題做第一層判斷（是參考基準，不是絕對門檻）：</p>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">問題一：書審投入意願</span>
        <h3>你願意承擔書審的工作量嗎？</h3>
        <p class="card-desc">法政推甄的準備不是排版問題，而是大量文獻閱讀、題目收斂、論證、反覆修改與推薦信安排。願意換取較高錄取機率的人，才撐得完這一段。</p>
      </article>
      <article class="card article-card">
        <span class="badge">問題二：文字證據</span>
        <h3>你有能證明論證能力的作品嗎？</h3>
        <p class="card-desc">課堂研究報告、小論文、大專生研究計畫、政策分析、法律個案分析都算。關鍵不是名目，而是有沒有一份東西能讓教授直接判斷你的問題定義與論證能力。</p>
      </article>
      <article class="card article-card">
        <span class="badge">問題三：長期壓力</span>
        <h3>你擅長長期整理，還是長期應試？</h3>
        <p class="card-desc">考試路線需要的是半年到一年、每天長時間獨自面對民刑法、公法或政治學的穩定投入。在校背景不具優勢、想跨校系翻盤的人，筆試往往是更直接的槓桿。</p>
      </article>
    </div>
    <p style="margin-top: 16px; color: var(--tbd-mid);">兩邊並行是可行的，但要先分清楚哪些工作共用（核心科目實力、次領域探索、校所研究）、哪些不共用（推甄的研究計畫與備審整合 vs 考試的長期申論訓練與考科進度）。完整的路線判斷與時間擠壓風險，見<a class="text-link" href="/pages/resources/law-graduate-timeline.html">法政研究所推甄時程</a>。</p>
  </section>

  <section class="section" id="stages">
    <h2>法政研究所申請的七個階段</h2>
    <div class="guide-rail-legend">
      <span><i class="own"></i>法政類群專屬深文</span>
      <span><i class="reuse"></i>沿用通用文章</span>
    </div>
    <div class="guide-rail">
      {stages.map((s) => (
        <a class={`rail-stage${s.tag !== '通用' ? ' own' : ''}`} href={s.href}>
          <span class="rs-num">{s.n}</span>
          <span class="rs-node"><i></i></span>
          <span class="rs-body">
            <span class="rs-tag">{s.tag}</span>
            <span class="rs-title">{s.title}</span>
            <span class="rs-role">{s.role}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="templates">
    <h2>法政推甄專屬工具包</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">五份對應各階段的工具，兩種格式任選：<strong>CSV</strong> 用 Excel / Google 試算表開；<strong>Markdown</strong> 可一鍵匯入 Notion。</p>
    <div class="card-grid">
      {templates.map((t) => (
        <article class="card article-card">
          <span class="badge">模板</span>
          <h3>{t.title}</h3>
          <p class="card-desc">{t.desc}</p>
          <div class="button-row" style="margin-top: 16px;">
            <a class="button" href={t.md} download data-track-event="download_resource">Notion / Markdown</a>
            <a class="button secondary" href={t.csv} download data-track-event="download_resource">CSV 試算表</a>
          </div>
          <p style="margin-top: 10px;"><a class="text-link" href={t.article}>看使用說明 →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="more">
    <h2>延伸與案例</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">成功案例</span>
        <h3><a class="text-link" href="/pages/cases.html">TBD Studio 升學輔導案例</a></h3>
        <p class="card-desc">去識別化的真實案例——素材盤點、敘事重構與模擬面試怎麼落實成錄取結果，跨域申請者也適用。</p>
      </article>
      <article class="card article-card">
        <span class="badge">通用指南</span>
        <h3><a class="text-link" href="/pages/guides/graduate-application.html">研究所推甄完整指南</a></h3>
        <p class="card-desc">不分科系的研究所推甄通用流程，想先掌握整體再回到法政類群專屬準備，從這裡開始。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>法政推甄的研究問題、文字作品與校所名單，想找人一起檢視？</h2>
    <p>TBD 的策略諮詢會依你的次領域方向、文字作品與目標校所，幫你判斷推甄與考試的路線配比、把一直收斂不下來的議題拆成一個可辯論的爭點，並檢視備審三份文件的分工與一致性，找出目前最該補強的階段。</p>
    <p class="cta-trust"><span>✓ 線上進行</span><span>✓ 不代寫</span><span>✓ 過程文件可追蹤</span></p>
    <div class="button-row">
      <a class="button secondary" href="/pages/services/graduate.html">看研究所推甄服務</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_graduate_law">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
