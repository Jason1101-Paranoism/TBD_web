---
// 免費諮詢 vs 策略諮詢對照（D-020）。服務頁、FAQ、首頁共用，內容只改這裡。
interface Props { id?: string }
const { id } = Astro.props;
const rows = [
  { label: '適合', free: '還在觀望、想先了解 TBD', paid: '準備認真規劃、需要完整評估' },
  { label: '做什麼', free: '15 分鐘聽你的現況，說明 TBD 能怎麼幫、適合從哪開始', paid: '依事先提供的學生資料，進行 60 分鐘深度盤點' },
  { label: '你會拿到', free: '口頭建議', paid: '回饋文件（策略建議報告）＋建議的後續方案' },
  { label: '費用', free: '免費', paid: 'NT$3,500，正式合作可全額折抵' },
];
---
<div class="table-wrap consult-compare-wrap" id={id}>
  <table class="consult-compare">
    <thead>
      <tr><th scope="col"><span class="sr-only">項目</span></th><th scope="col">免費諮詢</th><th scope="col">策略諮詢（付費）</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr><th scope="row">{r.label}</th><td>{r.free}</td><td>{r.paid}</td></tr>
      ))}
    </tbody>
  </table>
</div>
