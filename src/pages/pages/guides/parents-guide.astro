---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';

const title = '給家長：陪孩子準備升學的完整指南';
const description = '了解現行申請制度的邏輯、家長真正能幫上忙的角色，以及是否需要找升學顧問的判斷方式——TBD Studio 給家長系列文章完整收錄。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-parents`;

// 由 taxonomy 自動生成：category 為「給家長」的文章
const parentCards = (await getCollection('articles'))
  .filter((a) => a.data.category === '給家長')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((a) => ({ title: a.data.title, href: `/pages/resources/${a.slug}.html`, desc: a.data.description }));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/parents-guide.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/parents-guide.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南</span>
  <h1>{title}</h1>
  <p class="lead">108 課綱改變了升學準備的方式，家長的角色也需要跟著調整。這個頁面收錄 TBD Studio 所有給家長的文章，說明現行申請制度的邏輯、家長真正有幫助的支持方式，以及面對升學顧問選擇時的決策框架。</p>
</section>

<main>

  <section class="section" id="articles">
    <h2>給家長系列文章</h2>
    <div class="card-grid">
      {parentCards.map((card) => (
        <article class="card article-card">
          <span class="badge">給家長</span>
          <h3><a class="text-link" href={card.href}>{card.title}</a></h3>
          <p class="card-desc">{card.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="related">
    <h2>延伸閱讀</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">升學觀念</span>
        <h3><a class="text-link" href="/pages/resources/high-score-not-enough.html">為什麼高分不一定能申請上頂大？</a></h3>
        <p class="card-desc">分數是入場券，不是錄取標準。說明頂大真正在篩什麼，以及為什麼成績以外的東西越來越重要。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>孩子的準備方向讓你擔心，不知道從哪裡評估？</h2>
    <p>TBD 提供親子都可以一起參與的初次諮詢，幫你們確認現有材料的強弱、備審的主線方向，以及後續最值得投入的環節。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_parents">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
