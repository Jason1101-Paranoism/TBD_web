<script>
  document.querySelectorAll('.track-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const track = btn.dataset.track;
      document.querySelectorAll('.track-tab').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      document.querySelectorAll('.track-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.getElementById('track-' + track)?.classList.add('active');
    });
  });
</script>
