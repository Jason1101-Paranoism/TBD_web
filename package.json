{
  "name": "tbd-web",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run css && node scripts/prebuild.mjs && astro dev",
    "build": "npm run css && node scripts/prebuild.mjs && astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify.mjs",
    "gen": "node scripts/prebuild.mjs",
    "css": "tailwindcss -c tailwind.config.mjs -i src/styles/tailwind.css -o public/css/tailwind.css --minify"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/parser": "^8.63.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "tailwindcss": "^3.4.19"
  }
}
