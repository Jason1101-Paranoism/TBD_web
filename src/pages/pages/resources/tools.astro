---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { gradTemplateGroups, templateLinks } from '../../../config/gradTemplates';

// 分學群工具包依學群分組列出。資料來自 src/config/gradTemplates.ts，
// 與五個分學群指南頁同一份來源——新增學群不必再手動同步這一頁。
const gradGroups = gradTemplateGroups.map((g) => ({
  ...g,
  items: g.templates.map(templateLinks),
}));

const title = '升學工具與模板下載｜TBD Studio';
const description = '可下載的升學準備模板，依準備階段分組：找方向、累積與記錄、整理成果、面試、入學前，以及理工、生醫與公衛、商管財經、人文社科、藝術、教育六個學群各五份的研究所推甄工具包。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=tools`;

// 通用模板依「準備階段」分五組，組的順序就是準備的順序——位置本身在回答
// 「這件事什麼時候做」，那是單一平鋪網格給不了的資訊。11 份長成單一網格後
// 橫跨高中升學、Side Project、面試、入學前四種情境，平鋪讓人無從挑起。
//
// 份數刻意不均（3/2/2/2/1）。把「入學前」那一份硬湊進別組會讓分組失去意義——
// 不均是真實的，不用假分組掩蓋。
//
// 推甄時程甘特圖不在這裡：它的欄位是送件截止日與 17 個推甄任務，屬於研究所端，
// 原本錯放在通用區。已移到下方 #grad-toolkits 的跨學群區塊。
const downloadGroups = [
  {
    id: 'stage-explore',
    label: '一、找方向',
    why: '還沒決定要走哪條路、讀哪個科系的時候用。',
    items: [
      {
        title: '升學管道戰力評估雷達圖',
        desc: '11 個題目各給 1–5 分，個申／特選／分科三條路的平均分自動算出。它不告訴你走哪條，它告訴你哪條路你還缺什麼。',
        csv: '/assets/templates/admission-channel-radar.csv',
        md: '/assets/templates/admission-channel-radar.md',
        article: '/pages/resources/admission-channels-compare.html',
      },
      {
        title: '科系比較 Prompt 產生器',
        desc: '填五個變數，產生一份 8 階段的科系深度比較 Prompt——適用任何兩個科系的取捨。',
        csv: '/assets/templates/department-compare-prompt.csv',
        md: '/assets/templates/department-compare-prompt.md',
        article: '/pages/resources/department-compare-method.html',
      },
      {
        title: '科系探索訪談清單',
        desc: '訪談學長姐或從業者時可直接用的問題表，附「對方回答」與「我的判斷」欄位。',
        csv: '/assets/templates/department-interview-questions.csv',
        md: '/assets/templates/department-interview-questions.md',
        article: '/pages/resources/department-interview-questions.html',
      },
    ],
  },
  {
    id: 'stage-accumulate',
    label: '二、累積與記錄',
    why: '高一高二、或還在做東西的階段。記錄的時機是當下，不是備審前。',
    items: [
      {
        title: 'Side Project 執行追蹤板',
        desc: '填專案開始日，15 個任務的目標完成日自動排出、剩餘天數每天更新。前六項都還沒開始寫程式——那是刻意的。',
        csv: '/assets/templates/side-project-tracker.csv',
        md: '/assets/templates/side-project-tracker.md',
        article: '/pages/resources/side-project-from-zero.html',
      },
      {
        title: '學習歷程「反思」寫作引導',
        desc: '三種有效的反思結構，先選結構再下筆。附自我檢查：把活動名稱換掉還成立的話，就是太空泛。',
        csv: '/assets/templates/portfolio-reflection-guide.csv',
        md: '/assets/templates/portfolio-reflection-guide.md',
        article: '/pages/resources/reflection-in-portfolio.html',
      },
    ],
  },
  {
    id: 'stage-organize',
    label: '三、整理成果',
    why: '東西做完了，要變成別人看得懂的形式。',
    items: [
      {
        title: '備審主線整理表',
        desc: '把所有經歷攤開來，依「與目標科系的關聯」找出能串成一條主線的那幾項。',
        csv: '/assets/templates/admission-main-thread.csv',
        md: '/assets/templates/admission-main-thread.md',
        article: '/pages/resources/scatter-to-story.html',
      },
      {
        title: 'README 與 Portfolio 內容規劃表',
        desc: '區塊檢核表加一份可直接複製的 README 公版。先確認每個區塊有沒有，再處理好不好。',
        csv: '/assets/templates/readme-portfolio-planner.csv',
        md: '/assets/templates/readme-portfolio-planner.md',
        article: '/pages/resources/readme-guide.html',
      },
    ],
  },
  {
    id: 'stage-interview',
    label: '四、面試',
    why: '拿到面試通知之後，通常只剩兩到四週。',
    items: [
      {
        title: '面試答題素材工作表',
        desc: '含兩分鐘自我介紹的三段式填空，以及依五個題型整理「這題我要用哪段經歷」。搭配面試題庫頁一起用。',
        csv: '/assets/templates/interview-answer-material.csv',
        md: '/assets/templates/interview-answer-material.md',
        article: '/pages/resources/interview-self-intro.html',
      },
      {
        title: '系統性面試準備六層防護網',
        desc: '對象、背景、關係、素材、情境、流程六層逐層填。答不出來時通常不是表達的問題，是第三層沒建立起來。',
        csv: '/assets/templates/interview-six-layer-prep.csv',
        md: '/assets/templates/interview-six-layer-prep.md',
        article: '/pages/resources/lulu-preparation-system.html',
      },
    ],
  },
  {
    id: 'stage-pre-college',
    label: '五、入學前',
    why: '已經錄取了，暑假那個月。',
    items: [
      {
        title: '升大學前 30 天 Checklist',
        desc: '一個月四週的準備節奏：探索選題 → 做第一版 → 優化紀錄 → 整理表達。可勾選追蹤進度。',
        csv: '/assets/templates/pre-college-30day-checklist.csv',
        md: '/assets/templates/pre-college-30day-checklist.md',
        article: '/pages/resources/pre-college-30-day-checklist.html',
      },
    ],
  },
];

// 研究所端但不分學群的模板。放在分學群五組之前——申請流程上它比選校選教授更早，
// 而且五個學群都用得到。不進 gradTemplates.ts 是因為那份設定的結構是「學群 → 五份」，
// 硬塞一份跨學群的進去會讓指南頁也長出一張不屬於該學群的卡。
const gradShared = [
  {
    title: '推甄時程倒數與任務甘特圖',
    desc: '填一個日期——你第一間的送件截止日——17 個任務的建議起訖自動回推。CSV 版的日期欄是公式，改一格全部跟著動。',
    csv: '/assets/templates/graduate-timeline-gantt.csv',
    md: '/assets/templates/graduate-timeline-gantt.md',
    article: '/pages/resources/graduate-timeline.html',
  },
];

const relatedArticles = [
  {
    badge: '工具指南',
    title: '高中生怎麼用 Notion 整理學習歷程和 Side Project？',
    href: '/pages/resources/notion-system.html',
    desc: '把這些模板整合進一套你願意長期維護的 Notion 系統。',
  },
  {
    badge: '升大學前準備',
    title: '升大學前作品集資料夾怎麼整理？一套可複製的架構範例',
    href: '/pages/resources/portfolio-folder-structure.html',
    desc: '完整的資料夾架構與命名原則，搭配下方的紀錄卡範本使用。',
  },
  {
    badge: '工具指南',
    title: '高中生 AI 工具實用指南：哪些工具真的值得用？',
    href: '/pages/resources/ai-tools-guide.html',
    desc: '各準備階段最實用的 AI 工具，以及哪些用法反而會讓你退步。',
  },
];
---

<BaseLayout title={title} description={description} bodyClass="sub-page resources-page">
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>工具與模板</span>
  </nav>
  <span class="kicker">工具與模板</span>
  <h1>把準備變成可以動手的工具</h1>
  <p class="lead">知識看完還是要動手。這裡整理了可以直接下載使用的升學準備模板，以及可複製的範本——挑一個現在最用得到的開始。CSV 檔可用 Excel 或 Google 試算表開啟。</p>
</section>

<main class="search-main">

  <section class="section" id="downloads">
    <h2 class="section-label">可下載模板</h2>
    <p style="margin-bottom: 8px; color: var(--tbd-mid);">依準備的先後順序排列，不確定自己在哪一步就從第一組開始。兩種格式任選：<strong>CSV</strong> 用 Excel / Numbers / Google 試算表開；<strong>Markdown</strong> 可一鍵匯入 Notion（也能貼進 Google Docs）。</p>
    {downloadGroups.map((g) => (
      <div class="tool-group" id={g.id}>
        <h3 class="tool-group-title">
          {g.label}<span class="tool-group-count">{g.items.length} 份</span>
        </h3>
        <p class="tool-group-why">{g.why}</p>
        <div class="card-grid">
          {g.items.map((d) => (
            <article class="card article-card">
              <span class="badge">模板</span>
              <h4>{d.title}</h4>
              <p class="card-desc">{d.desc}</p>
              <div class="button-row" style="margin-top: 16px;">
                <a class="button" href={d.md} download data-track-event="download_resource">Notion / Markdown</a>
                <a class="button secondary" href={d.csv} download data-track-event="download_resource">CSV 試算表</a>
              </div>
              <p style="margin-top: 10px;"><a class="text-link" href={d.article}>看使用說明 →</a></p>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="section" id="grad-toolkits">
    <h2 class="section-label">研究所推甄：分學群工具包</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">每個學群五份，對應申請的五個關鍵階段：選校選教授、聯繫教授、研究／創作計畫、備審、口試。各學群的評估邏輯不同，模板的欄位也跟著不同——請用你要申請的學群那一組，不要混用。每份都有完整的使用說明文章。</p>

    <div class="tool-group" id="grad-shared">
      <h3 class="tool-group-title">
        跨學群共用<span class="tool-group-count">{gradShared.length} 份</span>
      </h3>
      <p class="tool-group-why">不分學群，先把時程排出來再看你那一組的五份。</p>
      <div class="card-grid">
        {gradShared.map((d) => (
          <article class="card article-card">
            <span class="badge">模板</span>
            <h4>{d.title}</h4>
            <p class="card-desc">{d.desc}</p>
            <div class="button-row" style="margin-top: 16px;">
              <a class="button" href={d.md} download data-track-event="download_resource">Notion / Markdown</a>
              <a class="button secondary" href={d.csv} download data-track-event="download_resource">CSV 試算表</a>
            </div>
            <p style="margin-top: 10px;"><a class="text-link" href={d.article}>看使用說明 →</a></p>
          </article>
        ))}
      </div>
    </div>

    {gradGroups.map((g) => (
      <div class="tool-group">
        <h3 class="tool-group-title">
          {g.label}<a class="text-link tool-group-link" href={g.guide}>看完整申請指南 →</a>
        </h3>
        <div class="card-grid">
          {g.items.map((d) => (
            <article class="card article-card">
              <span class="badge">模板</span>
              <h4>{d.title}</h4>
              <p class="card-desc">{d.desc}</p>
              <div class="button-row" style="margin-top: 16px;">
                <a class="button" href={d.md} download data-track-event="download_resource">Notion / Markdown</a>
                <a class="button secondary" href={d.csv} download data-track-event="download_resource">CSV 試算表</a>
              </div>
              <p style="margin-top: 10px;"><a class="text-link" href={d.article}>看使用說明 →</a></p>
            </article>
          ))}
        </div>
      </div>
    ))}
    <p style="margin-top: 20px; color: var(--tbd-mid);">找不到你的學群？設計傳播類群目前有<a class="text-link" href="/pages/guides/graduate-design.html">完整申請指南</a>但尚未附模板；其他學群可先用<a class="text-link" href="/pages/guides/graduate-application.html#matrix">通用七階段對照表</a>找到最接近的一組。</p>
  </section>

  <section class="section" id="interactive">
    <h2 class="section-label">互動工具</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">不想一次讀完整篇？先用測驗快速抓方向，再回到對應文章深入。</p>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">互動測驗</span>
        <h3><a class="text-link" href="/pages/grad-path-quiz.html">你適合研究所推甄還是考試？</a></h3>
        <p class="card-desc">10 題、約 3 分鐘，依你的成績、研究經歷與應試習慣，判斷你目前的條件比較適合哪一條入學管道，並延伸到完整選擇指南。</p>
      </article>
    </div>
  </section>

  <section class="section" id="how-to-use">
    <h2 class="section-label">怎麼變成你自己的正式模板</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">這些檔案是可直接使用的範本。想做成自己長期維護、或可分享給別人的版本，三步就好：</p>
    <ul class="content-list" style="color: var(--tbd-mid); line-height: 2;">
      <li><strong>匯入 Notion：</strong>新增一頁 → 左下／右上「⋯」→ Import → Markdown，選下載的 <code>.md</code> 檔。勾選項會變成 to-do、表格會變成 Notion 表格（可再轉成資料庫方便篩選）。</li>
      <li><strong>用 Google 試算表：</strong>新增試算表 → 檔案 → 匯入 → 上傳 <code>.csv</code>，即成為可填寫的表格；要分享給別人就設定共用權限。</li>
      <li><strong>用 Google Docs：</strong>把 <code>.md</code> 內容貼上（或開啟「以 Markdown 貼上」），再依需要調整格式。</li>
    </ul>
  </section>

  <section class="section" id="record-card">
    <h2 class="section-label">可直接複製：經歷紀錄卡</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">每完成一個專案、競賽或經歷，趁記憶清楚時花五分鐘填一張。它是未來備審與面試最珍貴的原料。</p>
    <pre><code>## 紀錄卡

- 名稱：
- 時間：
- 我做了什麼（具體）：
- 為什麼做這個：
- 遇到的最大困難 / 怎麼解決：
- 學到什麼 / 下次會怎麼做：
- 相關連結 / 檔案位置：</code></pre>
    <p style="margin-top: 16px; color: var(--tbd-mid);">完整的資料夾架構與命名原則，見 <a class="text-link" href="/pages/resources/portfolio-folder-structure.html">升大學前作品集資料夾怎麼整理</a>。</p>
  </section>

  <section class="section" id="related">
    <h2 class="section-label">延伸：相關工具文章</h2>
    <div class="card-grid">
      {relatedArticles.map((a) => (
        <article class="card article-card">
          <span class="badge">{a.badge}</span>
          <h3><a class="text-link" href={a.href}>{a.title}</a></h3>
          <p class="card-desc">{a.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section cta">
    <h2>想要更完整的客製模板？</h2>
    <p>實際合作時，我們會依照你的目標科系與現況，給你客製化的整理表與準備計畫。先從這些通用模板開始，需要更進一步時再聊。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_tools">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
