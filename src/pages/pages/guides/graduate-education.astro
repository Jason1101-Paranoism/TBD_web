---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';
import { templatesFor, gradGuideByDept } from '../../../config/gradTemplates';

// 教育類群研究所申請路徑：通用階段「重用」既有研究所推甄文章，
// 只有教育類群真正不同的環節（現場經驗轉研究問題的時程、次領域與場域選所、
// 教育研究計畫、實務×學術潛力備審、政策題與個案題口試）用教育專屬文。
const STAGE_ORDER = [
  { slug: 'graduate-recommend-vs-exam', tag: '通用',   role: '先理解推甄與考試的差異；教育類群的路線判斷基準見下方快篩。' },
  { slug: 'education-graduate-timeline', tag: '教育專屬', role: '研究問題不是大四上才想的東西——進現場、看出重複、收斂成問題，每一環都需要時間差。' },
  { slug: 'education-graduate-choose',   tag: '教育專屬', role: '排名之外，先看次領域、學術取向與實務場域：教育研究離不開現場，場域是綁在特定學校上的。' },
  { slug: 'graduate-contact-professor',  tag: '通用',   role: '送件前聯繫教授；教育類群要對齊取向、場域與指導方向，判斷方式直達文內〈教育類群專屬重點〉。', anchor: '#education-tips' },
  { slug: 'education-graduate-proposal', tag: '教育專屬', role: '不是教學方案也不是實習心得：從現場痛點到文獻缺口，再到做得完、拿得到對象的研究設計。' },
  { slug: 'education-graduate-cv',       tag: '教育專屬', role: 'CV 列事實、自傳講軌跡、計畫寫未來；讓現場經驗變成能力證據而不是活動紀錄。' },
  { slug: 'education-graduate-oral',     tag: '教育專屬', role: '不只是自我介紹：方法答辯五步、個案題六步，以及被問到盲點時怎麼回應。' },
];

const bySlug = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.slug, a])
);
const stages = STAGE_ORDER
  .map((s, i) => {
    const a = bySlug[s.slug];
    if (!a) return null;
    // anchor：通用文內的教育類群專屬區塊（#education-tips），總覽直接深連結到該段
    return { n: i + 1, tag: s.tag, role: s.role, title: a.data.title, href: `/pages/resources/${a.slug}.html${'anchor' in s && s.anchor ? s.anchor : ''}` };
  })
  .filter(Boolean);

// 可下載模板：資料在 src/config/gradTemplates.ts（與 resources/tools.html 同一份來源）
const templates = templatesFor('教育');

const title = gradGuideByDept['教育'].pageTitle;
const description = '教育研究所推甄怎麼準備？這個指南依申請順序拆成七個階段——從推甄與考試的路線判斷、以現場經驗轉研究問題為核心的時程規劃，到教育類群專屬的次領域與場域選所、教育研究計畫、實務與學術潛力並重的備審，以及政策題與個案題的口試，並附五份可下載模板。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-graduate-education`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/graduate-education.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "ItemList",
      "name": "教育研究所申請的七個階段",
      "itemListElement": stages.map((s) => ({
        "@type": "ListItem",
        "position": s.n,
        "name": s.title,
        "item": `${site.siteUrl}${s.href}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/graduate-education.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南 · 教育類群</span>
  <h1>{title}</h1>
  <p class="lead">教育類群涵蓋行政與政策、課程與教學、心理與諮商、特殊教育等次領域，申請的關鍵不是「有教育熱忱」，而是能不能把教學、政策、輔導或特教現場的經驗，轉化成可研究、可執行的學術問題。教授要從研究計畫、備審與口試中判斷的，是你有沒有能力把實務反思變成研究潛力。這個指南把申請拆成七個階段，和通用的研究所推甄指南同一套骨架：推甄與考試、聯繫教授沿用通用文章，教育類群真正不同的環節（現場經驗轉研究問題的時程、次領域與場域選所、教育研究計畫、實務×學術潛力備審、政策題與個案題口試）則有專屬深文，並附五份可直接下載的模板。建議照順序讀一遍，再回頭把卡住的階段讀深。</p>
</section>

<main>

  <section class="section" id="route-check">
    <h2>先做路線快篩：推甄、考試還是並行？</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">投入七個階段之前，先確認方向。教育類群的推甄與考試檢驗的是兩種不同的能力——建議用三個問題做第一層判斷（是參考基準，不是絕對門檻）：</p>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">問題一：在校表現</span>
        <h3>系排是否大致落在前 20%？</h3>
        <p class="card-desc">這是常被引用的參考基準，不是硬門檻。它真正的意義是：成績不具優勢的人，研究計畫與現場經驗就必須明顯拉開差距，否則第一階段書審很難被看見。</p>
      </article>
      <article class="card article-card">
        <span class="badge">問題二：實務證據</span>
        <h3>你有可被追問的現場經驗嗎？</h3>
        <p class="card-desc">代課、課輔、志工、輔導、實習、教案、大專生研究計畫都算。關鍵不是名目，而是那段經驗有沒有留下具體到能被追問的內容——那是研究動機的原料。</p>
      </article>
      <article class="card article-card">
        <span class="badge">問題三：擅長什麼</span>
        <h3>你擅長長期整理，還是長期應試？</h3>
        <p class="card-desc">推甄考的是把三年累積收斂成一份能被追問的研究敘事；考試考的是半年以上把教育學、心理學與統計念熟。跨領域轉考者，筆試往往是更直接的槓桿。</p>
      </article>
    </div>
    <p style="margin-top: 16px; color: var(--tbd-mid);">兩邊並行是可行的，但要先分清楚哪些工作共用（教育學與心理學基礎、次領域探索、校所研究）、哪些不共用（推甄的研究計畫與備審整合 vs 考試的長期學科進度）。完整的路線判斷（含推甄資料完成時間與考科準備會不會互相擠壓），見<a class="text-link" href="/pages/resources/education-graduate-timeline.html">教育研究所推甄時程</a>的第一節。</p>
  </section>

  <section class="section" id="stages">
    <h2>教育研究所申請的七個階段</h2>
    <div class="guide-rail-legend">
      <span><i class="own"></i>教育類群專屬深文</span>
      <span><i class="reuse"></i>沿用通用文章</span>
    </div>
    <div class="guide-rail">
      {stages.map((s) => (
        <a class={`rail-stage${s.tag !== '通用' ? ' own' : ''}`} href={s.href}>
          <span class="rs-num">{s.n}</span>
          <span class="rs-node"><i></i></span>
          <span class="rs-body">
            <span class="rs-tag">{s.tag}</span>
            <span class="rs-title">{s.title}</span>
            <span class="rs-role">{s.role}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="templates">
    <h2>教育推甄專屬工具包</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">五份對應各階段的工具，兩種格式任選：<strong>CSV</strong> 用 Excel / Google 試算表開；<strong>Markdown</strong> 可一鍵匯入 Notion。</p>
    <div class="card-grid">
      {templates.map((t) => (
        <article class="card article-card">
          <span class="badge">模板</span>
          <h3>{t.title}</h3>
          <p class="card-desc">{t.desc}</p>
          <div class="button-row" style="margin-top: 16px;">
            <a class="button" href={t.md} download data-track-event="download_resource">Notion / Markdown</a>
            <a class="button secondary" href={t.csv} download data-track-event="download_resource">CSV 試算表</a>
          </div>
          <p style="margin-top: 10px;"><a class="text-link" href={t.article}>看使用說明 →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="more">
    <h2>延伸與案例</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">成功案例</span>
        <h3><a class="text-link" href="/pages/cases.html">TBD Studio 升學輔導案例</a></h3>
        <p class="card-desc">去識別化的真實案例——素材盤點、敘事重構與模擬面試怎麼落實成錄取結果，跨域申請者也適用。</p>
      </article>
      <article class="card article-card">
        <span class="badge">通用指南</span>
        <h3><a class="text-link" href="/pages/guides/graduate-application.html">研究所推甄完整指南</a></h3>
        <p class="card-desc">不分科系的研究所推甄通用流程，想先掌握整體再回到教育類群專屬準備，從這裡開始。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>教育推甄的現場經驗、研究問題與校所名單，想找人一起檢視？</h2>
    <p>TBD 的策略諮詢會依你的次領域方向、現場經驗與目標校所，幫你判斷推甄與考試的路線配比、把重複出現的現場困惑收斂成一個做得完的研究問題，並檢視備審三份文件的分工與一致性，找出目前最該補強的階段。</p>
    <p class="cta-trust"><span>✓ 線上進行</span><span>✓ 不代寫</span><span>✓ 過程文件可追蹤</span></p>
    <div class="button-row">
      <a class="button secondary" href="/pages/services/graduate.html">看研究所推甄服務</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_graduate_education">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
