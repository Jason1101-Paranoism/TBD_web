---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';
import { templatesFor } from '../../../config/gradTemplates';

// 藝術類群研究所申請路徑：通用階段「重用」既有研究所推甄文章，
// 只有藝術類群真正不同的環節（作品集與母題時程、工作室與創作取向選所、
// 創作研究計畫、作品集備審、作品答辯）用藝術專屬文。
const STAGE_ORDER = [
  { slug: 'graduate-recommend-vs-exam', tag: '通用',   role: '先理解推甄與考試的差異；藝術類群的路線判斷基準見下方快篩。' },
  { slug: 'arts-graduate-timeline',     tag: '藝術專屬', role: '作品集不是大四才排版的文件——補作、重拍、重建脈絡都需要時間差，壓縮不了。' },
  { slug: 'arts-graduate-choose',       tag: '藝術專屬', role: '校名相近，訓練可能完全不同：用創作方向、教授與工作室、系所文化三層收斂名單。' },
  { slug: 'graduate-contact-professor', tag: '通用',   role: '送件前聯繫教授；藝術類群要先有可閱讀的作品集，判斷方式直達文內〈藝術類群專屬重點〉。', anchor: '#arts-tips' },
  { slug: 'arts-graduate-proposal',     tag: '藝術專屬', role: '不是感性描述也不是理論外掛：十節架構，把既有創作往前延伸成一份工作計畫。' },
  { slug: 'arts-graduate-cv',           tag: '藝術專屬', role: '作品集是經過選擇與編排的創作論述，不是全集；CV、自傳與計畫各有分工。' },
  { slug: 'arts-graduate-oral',         tag: '藝術專屬', role: '答辯不是朗讀作品說明：四類追問、五步答題框架，以及被質疑時該怎麼回應。' },
];

const bySlug = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.slug, a])
);
const stages = STAGE_ORDER
  .map((s, i) => {
    const a = bySlug[s.slug];
    if (!a) return null;
    // anchor：通用文內的藝術類群專屬區塊（#arts-tips），總覽直接深連結到該段
    return { n: i + 1, tag: s.tag, role: s.role, title: a.data.title, href: `/pages/resources/${a.slug}.html${'anchor' in s && s.anchor ? s.anchor : ''}` };
  })
  .filter(Boolean);

// 可下載模板：資料在 src/config/gradTemplates.ts（與 resources/tools.html 同一份來源）
const templates = templatesFor('藝術');

const title = '藝術研究所申請完整指南';
const description = '藝術研究所推甄怎麼準備？這個指南依申請順序拆成七個階段——從推甄與考試的路線判斷、以作品集與母題為核心的時程規劃，到藝術類群專屬的工作室與創作取向選所、創作研究計畫、作品集備審與作品答辯，並附五份可下載模板。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-graduate-arts`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/graduate-arts.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "ItemList",
      "name": "藝術研究所申請的七個階段",
      "itemListElement": stages.map((s) => ({
        "@type": "ListItem",
        "position": s.n,
        "name": s.title,
        "item": `${site.siteUrl}${s.href}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/graduate-arts.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南 · 藝術類群</span>
  <h1>{title}</h1>
  <p class="lead">藝術研究所和設計類群雖然都看作品，評估邏輯卻不一樣：設計研究著重問題解決與應用，藝術研究著重創作者如何持續發展自己的母題、觀點與形式語言。教授要從作品集、創作計畫與口試中判斷的，是你能不能把作品轉化成可被理解、可被追問、可以繼續深化的創作研究。這個指南把申請拆成七個階段，和通用的研究所推甄指南同一套骨架：推甄與考試、聯繫教授沿用通用文章，藝術類群真正不同的環節（作品集與母題時程、工作室與創作取向選所、創作研究計畫、作品集備審、作品答辯）則有專屬深文，並附五份可直接下載的模板。建議照順序讀一遍，再回頭把卡住的階段讀深。</p>
</section>

<main>

  <section class="section" id="route-check">
    <h2>先做路線快篩：推甄、考試還是並行？</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">投入七個階段之前，先確認方向。藝術類群的推甄與考試不只是兩條入學路徑，而是兩種不同的能力展示場域——建議用三個問題做第一層判斷（是參考基準，不是絕對門檻）：</p>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">問題一：作品脈絡</span>
        <h3>作品之間看得出同一條線索嗎？</h3>
        <p class="card-desc">推甄看的完整度不是件數，而是能不能看出主要母題、可說明的媒材選擇與系列之間的發展關係。若目前只是單件作品的集合，第一階段書審會很吃力。</p>
      </article>
      <article class="card article-card">
        <span class="badge">問題二：現場表現</span>
        <h3>限時術科與筆試是你的優勢嗎？</h3>
        <p class="card-desc">考試路線要求現場創作能力、術科基本功與學科筆試的穩定度。在校成績不具明顯優勢、作品集尚未形成脈絡的人，現場表現往往是更有效的槓桿。</p>
      </article>
      <article class="card article-card">
        <span class="badge">問題三：創作契合</span>
        <h3>你的媒材與方向，目標系所支援嗎？</h3>
        <p class="card-desc">同一個系名底下，可能一邊是傳統媒材的深度磨練，一邊是科技藝術與跨域實驗。設備、工作室與教授取向的契合度，比排名更能決定這兩年怎麼過。</p>
      </article>
    </div>
    <p style="margin-top: 16px; color: var(--tbd-mid);">兩邊並行是可行的，但要先分清楚哪些工作共用（作品整理、創作計畫、藝術史基礎、口語表達、校所研究）、哪些不共用（推甄的長期書審整合 vs 考試的術科與筆試訓練）。完整的路線判斷（含「推甄未錄取時術科準備能否延續」這個現實問題），見<a class="text-link" href="/pages/resources/arts-graduate-timeline.html">藝術研究所推甄時程</a>的第一節。</p>
  </section>

  <section class="section" id="stages">
    <h2>藝術研究所申請的七個階段</h2>
    <div class="guide-rail-legend">
      <span><i class="own"></i>藝術類群專屬深文</span>
      <span><i class="reuse"></i>沿用通用文章</span>
    </div>
    <div class="guide-rail">
      {stages.map((s) => (
        <a class={`rail-stage${s.tag !== '通用' ? ' own' : ''}`} href={s.href}>
          <span class="rs-num">{s.n}</span>
          <span class="rs-node"><i></i></span>
          <span class="rs-body">
            <span class="rs-tag">{s.tag}</span>
            <span class="rs-title">{s.title}</span>
            <span class="rs-role">{s.role}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="templates">
    <h2>藝術推甄專屬工具包</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">五份對應各階段的工具，兩種格式任選：<strong>CSV</strong> 用 Excel / Google 試算表開；<strong>Markdown</strong> 可一鍵匯入 Notion。</p>
    <div class="card-grid">
      {templates.map((t) => (
        <article class="card article-card">
          <span class="badge">模板</span>
          <h3>{t.title}</h3>
          <p class="card-desc">{t.desc}</p>
          <div class="button-row" style="margin-top: 16px;">
            <a class="button" href={t.md} download data-track-event="download_resource">Notion / Markdown</a>
            <a class="button secondary" href={t.csv} download data-track-event="download_resource">CSV 試算表</a>
          </div>
          <p style="margin-top: 10px;"><a class="text-link" href={t.article}>看使用說明 →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="more">
    <h2>延伸與案例</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">成功案例</span>
        <h3><a class="text-link" href="/pages/cases.html">TBD Studio 升學輔導案例</a></h3>
        <p class="card-desc">去識別化的真實案例——素材盤點、敘事重構與模擬面試怎麼落實成錄取結果，跨域申請者也適用。</p>
      </article>
      <article class="card article-card">
        <span class="badge">通用指南</span>
        <h3><a class="text-link" href="/pages/guides/graduate-application.html">研究所推甄完整指南</a></h3>
        <p class="card-desc">不分科系的研究所推甄通用流程，想先掌握整體再回到藝術類群專屬準備，從這裡開始。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>藝術推甄的作品集脈絡、校所名單與創作計畫，想找人一起檢視？</h2>
    <p>TBD 的策略諮詢會依你的作品累積、創作母題與目標校所，幫你判斷推甄與考試的路線配比、把作品收斂成一條看得出發展的線索，並檢視創作計畫與既有實踐的連結強度，找出目前最該補強的階段。</p>
    <p class="cta-trust"><span>✓ 線上進行</span><span>✓ 不代寫</span><span>✓ 過程文件可追蹤</span></p>
    <div class="button-row">
      <a class="button secondary" href="/pages/services/graduate.html">看研究所推甄服務</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_graduate_arts">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
