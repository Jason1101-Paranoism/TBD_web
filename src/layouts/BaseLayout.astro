---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  canonicalUrl?: string;
  ogType?: string;
  seoTitle?: string;
  schema?: object;
  noindex?: boolean;
}

const { title, description, bodyClass = '', canonicalUrl, ogType = 'website', seoTitle, schema, noindex = false } = Astro.props;
const canonical = canonicalUrl ?? `${site.siteUrl}${Astro.url.pathname}`;

// 品牌後綴由這裡統一決定，來源檔不要自己接（A-07）。
//
// 中文 SERP 約 30 字截斷。原本 152 頁把「｜TBD Studio」手寫進 title，佔掉 11 字，
// 結果 129 頁超標——而被截掉的正好就是品牌後綴，等於既沒顯示品牌、又吃掉了描述空間。
// 規則：接得下才接；接不下就讓標題把 30 字全用在內容上。
// 品牌訊號不會因此消失——og:site_name 與 Organization schema 都還在。
//
// 結尾的 replace 是防呆：來源檔若又被手動接上後綴，不會變成接兩次。
const BRAND = '｜TBD Studio';
const baseTitle = (seoTitle ?? title).replace(/｜TBD Studio$/, '').trim();
const pageTitle = baseTitle.length + BRAND.length <= 30 ? baseTitle + BRAND : baseTitle;

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "name": "TBD Studio",
      "url": site.siteUrl,
      "email": site.email,
      // logo 決定知識面板有沒有標誌；sameAs 是 AI 引擎做跨平台實體消歧的依據（A-01）。
      // 兩者的值本來就在 site.ts 裡，只是沒有被寫進 schema。
      "logo": {
        "@type": "ImageObject",
        "url": `${site.siteUrl}${site.logoUrl}`
      },
      "sameAs": [site.igUrl, site.lineUrl],
      "description": "TBD Studio 是台灣專注升學申請策略的教育顧問，協助高中生與研究所學生完成方向判斷、備審重構、學習歷程整理與面試訓練。每一步準備都可追蹤、可驗收。",
      "areaServed": "TW",
      "availableLanguage": "zh-TW"
    },
    {
      "@type": "WebSite",
      "name": "TBD Studio",
      "url": site.siteUrl,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${site.siteUrl}/pages/resources.html?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
};
---

<!doctype html>
<html lang="zh-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700;800&family=EB+Garamond:wght@400;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script is:inline>
    // tailwind 由上一行的 cdn.tailwindcss.com 注入，是執行期全域，非本檔宣告
    /* global tailwind */
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'tbd-light': '#D0CEDB',
            'tbd-mid': '#6A6D89',
            'tbd-accent': '#1A5D94',
            'tbd-dark': '#142143',
            'tbd-yellow': '#FAB748',
          },
          fontFamily: {
            sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
            serif: ['EB Garamond', 'serif'],
          },
          boxShadow: {
            'soft': '0 10px 30px rgba(20, 33, 67, 0.08)',
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  <GoogleAnalytics />
  <meta name="google-site-verification" content="google524eb5b6fa89d030">
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content="zh_TW">
  <meta property="og:site_name" content="TBD Studio">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={site.ogImage}>
  <meta property="og:image:width" content={String(site.ogImageWidth)}>
  <meta property="og:image:height" content={String(site.ogImageHeight)}>
  <meta property="og:image:alt" content="TBD Studio — 升學申請策略顧問">
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={site.ogImage}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(siteSchema)} />
  {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main-content">跳到主要內容</a>
  <Nav />
  <div id="main-content" tabindex="-1"></div>
  <slot />
  <Footer />
  <script src="/js/main.js" is:inline></script>
</body>
</html>
