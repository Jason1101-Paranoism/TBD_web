---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';

const title = '升大學前準備完整指南';
const description = '升大學前該做的不是把大學課程提前念完，而是探索、先修、作品與表達。TBD Studio 收錄各科系與通用的升大學前準備文章，幫你把這段空檔用在對的地方。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-pre-college`;

// 由 taxonomy 自動生成：category 為「升大學前準備」的文章
const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === '升大學前準備')
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const generalCards = articles
  .filter((a) => !a.data.departmentGroup)
  .map((a) => ({ badge: a.data.kicker, title: a.data.title, href: `/pages/resources/${a.slug}.html`, desc: a.data.description }));

const deptCards = articles
  .filter((a) => a.data.departmentGroup)
  .map((a) => ({ badge: a.data.departmentGroup, title: a.data.title, href: `/pages/resources/${a.slug}.html`, desc: a.data.description }));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/pre-college.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/pre-college.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南</span>
  <h1>{title}</h1>
  <p class="lead">不管你是還在高中想提早探索，還是剛考完、準備迎接大一的暑假，升大學前真正值得做的是四件事：探索方向、補上底層先修、做出第一個作品、練好表達。這個頁面收錄通用與各科系的準備文章，幫你把這段沒有考試壓力的空檔，用在最有累積的地方。</p>
</section>

<main>

  <section class="section" id="start">
    <h2>從這裡開始：通用準備與工具</h2>
    <div class="card-grid">
      {generalCards.map((card) => (
        <article class="card article-card">
          <span class="badge">{card.badge}</span>
          <h3><a class="text-link" href={card.href}>{card.title}</a></h3>
          <p class="card-desc">{card.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="departments">
    <h2>分科系準備方向</h2>
    <div class="card-grid">
      {deptCards.map((card) => (
        <article class="card article-card">
          <span class="badge">{card.badge}</span>
          <h3><a class="text-link" href={card.href}>{card.title}</a></h3>
          <p class="card-desc">{card.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section cta">
    <h2>想把升大學前準備變成一套可執行的計畫？</h2>
    <p>TBD 的策略諮詢會依照你的目標科系、目前的經歷與可投入的時間，一起規劃科系探索、作品累積與能力養成的具體路線——共創，不代筆。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_pre_college">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
