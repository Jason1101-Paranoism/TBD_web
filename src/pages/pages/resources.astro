---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SituationCards from '../../components/SituationCards.astro';
import { getCollection } from 'astro:content';
import { resourceCategories } from '../../config/resourceCategories';
import { starterPath } from '../../config/resourceSituations';

const articles = await getCollection('articles');
const bySlug = new Map(articles.map((a) => [a.slug, a]));

// 新手必讀路線：把設定裡的 slug 解析成標題與連結（缺 slug 會警告但不中斷）
const starterSteps = starterPath
  .map((step) => {
    const a = bySlug.get(step.slug);
    if (!a) {
      console.warn(`[resources] 新手必讀路線找不到 slug：${step.slug}（已略過）`);
      return null;
    }
    return { title: a.data.title, href: `/pages/resources/${a.slug}.html`, note: step.note };
  })
  .filter((x): x is { title: string; href: string; note: string } => x !== null);

// 瀏覽態的分類分區：從 collection 自動分組並排序產生卡片
const sections = resourceCategories.map((cat) => {
  const articleCards = articles
    // 研究所推甄區只列通用文；分學群專屬文（帶 departmentGroup）走指南卡與科系群篩選，不灌爆瀏覽區
    .filter((a) => a.data.category === cat.category && !(cat.category === '研究所推甄' && a.data.departmentGroup))
    .map((a) => ({
      kicker: a.data.kicker,
      title: a.data.title,
      href: `/pages/resources/${a.slug}.html`,
      desc: a.data.description,
      order: a.data.order ?? 999,
    }));
  const cards = [...articleCards, ...(cat.extraCards ?? [])].sort(
    (x, y) => x.order - y.order
  );
  return { ...cat, cards };
});

// 對照檢查：有 category 但對不到任何分區的文章（協助維護，不影響輸出）
const knownCategories = new Set(resourceCategories.map((c) => c.category));
const orphans = articles.filter((a) => !knownCategories.has(a.data.category));
if (orphans.length > 0) {
  console.warn(
    `[resources] 以下文章的 category 對不到任何分區，不會顯示在首頁：` +
      orphans.map((a) => `${a.slug} (${a.data.category})`).join(', ')
  );
}

// 主題指南：深入單一主題的整合頁。原本 15 張卡片平鋪造成首屏認知超載，
// 改以「使用者旅程」為底層邏輯收斂成 3 個母分類 Tabs（策略→經歷→備審），
// 每個 Tab 5 份指南，符合米勒法則 7±2 且彼此不重疊（MECE）。
const guideTabs = [
  {
    id: 'strategy',
    label: '策略與佈局',
    guides: [
      { title: '申請策略全局觀', href: '/pages/guides/admission-overview.html' },
      { title: '各科系申請指南', href: '/pages/guides/departments.html' },
      // 分學群研究所指南（設計／理工／生醫／商管／人文社科）不在這層平鋪，
      // 改由「研究所推甄完整指南」內的 7 階段 × 各學群對照表欄位標題進入，
      // 避免知識庫最外層被同一主題的五份指南灌爆。
      { title: '研究所推甄完整指南', href: '/pages/guides/graduate-application.html' },
      { title: '給家長完整指南', href: '/pages/guides/parents-guide.html' },
      { title: '升大學前準備', href: '/pages/guides/pre-college.html' },
    ],
  },
  {
    id: 'experience',
    label: '經歷與專案',
    guides: [
      { title: '研究與自學累積', href: '/pages/guides/research.html' },
      { title: 'Side Project 指南', href: '/pages/guides/side-project.html' },
      { title: 'GitHub & Portfolio', href: '/pages/guides/github.html' },
      { title: '競賽完整指南', href: '/pages/guides/competitions.html' },
      { title: 'AI 時代能力建立', href: '/pages/guides/ai-era.html' },
    ],
  },
  {
    id: 'application',
    label: '備審面試與資源',
    guides: [
      { title: '備審與學習歷程', href: '/pages/guides/portfolio-prep.html' },
      { title: '升學面試準備', href: '/pages/guides/interview.html' },
      { title: '大學面試題庫', href: '/pages/resources/interview-bank.html' },
      { title: '工具與模板下載', href: '/pages/resources/tools.html' },
      { title: '社群資源/懶人包', href: '/pages/resources/library.html' },
    ],
  },
];

// ── 即時搜尋／篩選用資料（原 search.astro 的資料準備，整合進同一頁）──
const mdxData = articles.map((a) => ({
  title: a.data.title,
  kicker: a.data.kicker,
  description: a.data.description,
  category: a.data.category,
  dept: a.data.departmentGroup ?? '',
  href: `/pages/resources/${a.slug}.html`,
}));

const staticPages = [
  {
    title: 'Portfolio 指南：高中生從 0 建立個人作品集',
    kicker: 'Portfolio 指南',
    description: '什麼是 Portfolio、為什麼高中生需要、如何從零開始建立個人網站作品集，含架構模板、工具選擇與真實案例。',
    category: '工具與延伸',
    dept: '',
    href: '/pages/portfolio-guide.html',
  },
  // 分學群指南已從主題指南與分類卡片收起，瀏覽動線改走對照表欄位標題；
  // 但搜尋是另一個進入點——直接搜「設計研究所」的人要找得到，五份都要在。
  {
    title: '設計研究所申請指南',
    kicker: '分學群指南',
    description: '設計類群研究所申請七階段：學術型vs實務型選校、研究計畫×作品集、口試講評，含通用與設計專屬文章地圖。',
    category: '研究所推甄',
    dept: '設計傳播',
    href: '/pages/guides/graduate-design.html',
  },
  {
    title: '理工研究所申請指南',
    kicker: '分學群指南',
    description: '理工類群研究所申請七階段：大二暑假起跑的時程、選實驗室、技術匹配研究計畫、備審與口試答辯，附五份下載模板。',
    category: '研究所推甄',
    dept: '理工',
    href: '/pages/guides/graduate-engineering.html',
  },
  {
    title: '生醫與公衛研究所申請指南',
    kicker: '分學群指南',
    description: '生醫與公衛類群研究所申請七階段：雙軌時程、選實驗室、可行性研究計畫書、研究誠信備審與研究限制答辯，附五份下載模板。',
    category: '研究所推甄',
    dept: '生醫',
    href: '/pages/guides/graduate-biomed.html',
  },
  {
    title: '商管與財經研究所申請指南',
    kicker: '分學群指南',
    description: '商管與財經類群研究所申請七階段：經歷整合時程、選校所定位、可研究的問題、商業故事線備審與綜合能力口試，附五份下載模板。',
    category: '研究所推甄',
    dept: '商管財經',
    href: '/pages/guides/graduate-business.html',
  },
  {
    title: '人文與社會科學研究所申請指南',
    kicker: '分學群指南',
    description: '人文社科類群研究所申請七階段：文獻與初稿期時程、學術傳統選所、問題意識與文獻對話、文字作品備審與研究計畫答辯，附五份下載模板。',
    category: '研究所推甄',
    dept: '人文社科',
    href: '/pages/guides/graduate-humanities.html',
  },
  {
    title: '升學工具與模板下載',
    kicker: '工具與模板',
    description: '可下載的升學準備模板：30 天 Checklist、備審主線整理表、科系比較 Prompt 產生器、理工研究所五套模板等，CSV 與 Notion 雙格式。',
    category: '工具與延伸',
    dept: '',
    href: '/pages/resources/tools.html',
  },
];

const articleData = [...mdxData, ...staticPages];

// 篩選維度選項：依設定檔順序排列，只保留實際有文章的值
const categoryOrder = resourceCategories.map((c) => c.category);
const categories = categoryOrder.filter((c) => articleData.some((a) => a.category === c));

const deptOrder = ['理工', '醫藥衛生', '商管財經', '人文社科', '設計傳播', '藝術', '教育', '法政', '農生環境'];
const presentDepts = [...new Set(articleData.map((a) => a.dept).filter(Boolean))];
const departments = [
  ...deptOrder.filter((x) => presentDepts.includes(x)),
  ...presentDepts.filter((x) => !deptOrder.includes(x)),
];
---

<BaseLayout title="升學知識庫｜TBD Studio" description="TBD Studio 升學知識文章：申請策略、備審製作、材料累積、面試準備、各科系指南與研究所推甄，幫助你做出更清楚的準備決策。支援關鍵字搜尋與分類、科系群篩選。" bodyClass="sub-page resources-page">
<section class="hero">
  <span class="kicker">TBD Studio 知識庫</span>
  <h1>升學路上，你需要知道的事。</h1>
  <p class="lead">從管道選擇、備審整理、材料累積到面試準備，彙整各科系申請指南與研究所推甄策略，幫助你把力氣用在對的地方。</p>
</section>

<main>

<!-- 常駐搜尋 + 三維篩選 + 快速入口：前置到 hero 正下方（回訪者找文章的最短路徑） -->
<section class="resources-search-section" id="search-section">
  <form class="resources-search-bar" id="search-form" autocomplete="off">
    <div class="resources-search-wrap">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--tbd-mid); flex-shrink: 0;">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="search" id="search-input" name="q" placeholder="搜尋文章關鍵字，例如：面試、Side Project、GitHub…" class="resources-search-input" autocomplete="off" aria-label="搜尋文章">
      <button type="submit" class="resources-search-btn">搜尋</button>
    </div>
    {departments.length > 0 && (
      <select id="dept-select" class="resources-dept-select" aria-label="依科系群篩選">
        <option value="">所有科系</option>
        {departments.map((d) => (
          <option value={d}>{d}</option>
        ))}
      </select>
    )}
  </form>

  <div class="search-filters resources-filters" id="search-filters">
    <div class="search-filter-group">
      <span class="search-filter-label">分類</span>
      <div class="filter-pill-row" data-dim="category">
        <button type="button" class="filter-pill active" data-value="">全部</button>
        {categories.map((c) => (
          <button type="button" class="filter-pill" data-value={c}>{c}</button>
        ))}
      </div>
    </div>
  </div>

  <nav class="anchor-chips resources-quicklinks" aria-label="快速入口">
    <a href="/pages/resources/tools.html">工具與模板下載</a>
    <a href="/pages/resources/library.html">社群資源懶人包</a>
    <a href="/pages/resources/interview-bank.html">大學面試題庫</a>
  </nav>
</section>

<!-- 引導區：新手路線 → 主題指南 → 依狀況找文章 -->
<div class="resources-intro">
  {starterSteps.length > 0 && (
    <section class="starter-path">
      <div class="situation-head">
        <h2 class="situation-heading">對大學申請毫無頭緒？我們帶你看懂</h2>
        <p class="situation-sub">五篇文章，從「升學在比什麼」到「教授怎麼看備審」，建立整體框架再深入細節。</p>
      </div>
      <ol class="starter-steps">
        {starterSteps.map((step, i) => (
          <li class="starter-step">
            <span class="starter-num">{i + 1}</span>
            <div class="starter-text">
              <a class="starter-link" href={step.href} data-track-event="click_starter_path" data-ga-event={`starter-step-${i + 1}`}>{step.title}</a>
              <p class="starter-note">{step.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="guide-index">
    <div class="situation-head">
      <h2 class="situation-heading">主題指南</h2>
      <p class="situation-sub">想深入某個主題？依你目前的階段選一個分類，每份指南把該主題的重點與相關文章整理成一條線。</p>
    </div>
    <div class="guide-tabs" role="tablist" aria-label="主題指南分類">
      {guideTabs.map((tab, i) => (
        <button
          type="button"
          class={`guide-tab${i === 0 ? ' active' : ''}`}
          role="tab"
          id={`guide-tab-${tab.id}`}
          aria-controls={`guide-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-guide-tab={tab.id}
        >{tab.label}</button>
      ))}
    </div>
    {guideTabs.map((tab, i) => (
      <div
        class={`guide-tabpanel${i === 0 ? ' active' : ''}`}
        role="tabpanel"
        id={`guide-panel-${tab.id}`}
        aria-labelledby={`guide-tab-${tab.id}`}
        hidden={i !== 0}
      >
        <div class="guide-grid">
          {tab.guides.map((g) => (
            <a class="guide-card" href={g.href}>
              <span class="guide-card-title">{g.title}</span>
              <span class="guide-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <SituationCards variant="home" />
</div>

<!-- 文章區：瀏覽分類 grid ↔ 搜尋/篩選結果，就地在同一塊切換 -->
<div class="resources-main" id="resources-main">

  <div class="resources-content">

    <!-- 搜尋/篩選結果（預設隱藏，就地取代下方分類 grid） -->
    <div id="search-results" hidden>
      <div class="active-filter-bar" id="active-filter-bar">
        <span class="active-filter-label" id="active-filter-label">篩選條件：</span>
        <span class="active-filter-chips" id="active-filter-chips"></span>
        <span class="active-filter-count" id="results-count" role="status" aria-live="polite"></span>
        <button type="button" id="back-to-browse" class="active-filter-clear">清除全部，回到瀏覽</button>
      </div>
      <div id="results-grid" class="card-grid"></div>
      <div id="no-results" class="search-empty" hidden>
        <p id="no-results-msg">找不到符合的文章，試試其他關鍵字或分類。</p>
      </div>
    </div>

    <!-- 分類瀏覽（預設顯示） -->
    <div id="browse-grid">
      {sections.map((s, i) => (
        <>
          <section class="section" id={s.id}>
            <h2 class="section-label">{s.sectionLabel}</h2>
            <p style="margin-bottom: 16px; color: var(--tbd-mid);">{s.desc}</p>
            <div class="card-grid">
              {s.cards.map((card, ci) => (
                <article class="card article-card" hidden={ci >= 6} data-overflow={ci >= 6 ? 'true' : undefined}>
                  <span class="badge">{card.kicker}</span>
                  <h3><a class="text-link" href={card.href}>{card.title}</a></h3>
                  <p class="card-desc">{card.desc}</p>
                </article>
              ))}
            </div>
            {s.cards.length > 6 && (
              <button type="button" class="browse-more" data-section={s.id}>展開全部 {s.cards.length} 篇 ↓</button>
            )}
          </section>
          {i === 4 && (
            <aside class="inline-cta">
              <div class="inline-cta-text">
                <h3>看了很多文章，但不確定自己的經歷該怎麼串連？</h3>
                <p>把現有的專題、競賽與自學經歷交給顧問看一遍，幫你找出個人主線與最該補強的環節。</p>
              </div>
              <a class="button" href="https://lin.ee/9ciZvbA?utm_source=website&utm_medium=cta&utm_campaign=resources-inline" target="_blank" rel="noopener noreferrer" data-track-event="click_consultation_cta" data-ga-event="resources-inline-cta">讓顧問幫你檢視現有材料 →</a>
            </aside>
          )}
        </>
      ))}

      <section class="section cta">
        <h2>準備開始，但不確定下一步？</h2>
        <p>TBD 的第一次策略諮詢從學生的升學管道、目前的材料狀況出發，評估最需要補強的環節，給你一份具體的準備建議——不管後續有沒有繼續合作都帶得走。</p>
        <div class="button-row">
          <a class="button secondary" href="/pages/services.html">了解服務內容</a>
          <a class="button" href="https://lin.ee/9ciZvbA?utm_source=website&utm_medium=cta&utm_campaign=resources" target="_blank" rel="noopener noreferrer" data-ga-event="click_line_resources">預約策略諮詢</a>
        </div>
      </section>
    </div>

  </div>
</div>
</main>

<script is:inline define:vars={{ articleData }}>
(function() {
  var data = articleData;
  var currentQuery = '';
  // 各維度目前選取的值（空字串 = 全部）
  var filters = { category: '', dept: '' };

  var searchInput = document.getElementById('search-input');
  var searchForm = document.getElementById('search-form');
  var resultsGrid = document.getElementById('results-grid');
  var noResults = document.getElementById('no-results');
  var noResultsMsg = document.getElementById('no-results-msg');
  var resultsCount = document.getElementById('results-count');
  var searchResults = document.getElementById('search-results');
  var browseGrid = document.getElementById('browse-grid');
  var resourcesMain = document.getElementById('resources-main');
  var searchSection = document.getElementById('search-section');
  var backBtn = document.getElementById('back-to-browse');
  var deptSelect = document.getElementById('dept-select');
  var filterChips = document.getElementById('active-filter-chips');
  var filterLabel = document.getElementById('active-filter-label');

  // 主題指南 3 分類 Tabs：純前端 DOM 抽換 + 淡入
  var guideTabBtns = document.querySelectorAll('.guide-tab');
  guideTabBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.dataset.guideTab;
      guideTabBtns.forEach(function(b) {
        var on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      document.querySelectorAll('.guide-tabpanel').forEach(function(panel) {
        var on = panel.id === 'guide-panel-' + id;
        panel.classList.toggle('active', on);
        panel.hidden = !on;
      });
    });
  });

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function highlight(text, query) {
    if (!query) return escapeHtml(text);
    var escaped = escapeHtml(text);
    var escapedQuery = escapeHtml(query).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return escaped.replace(new RegExp('(' + escapedQuery + ')', 'gi'), '<mark>$1</mark>');
  }

  function hasActiveFilter() {
    return !!(filters.category || filters.dept);
  }
  function isDefault() {
    return !currentQuery && !hasActiveFilter();
  }

  function matchesFilters(a) {
    var q = (currentQuery || '').toLowerCase().trim();
    var matchesQuery = !q ||
      a.title.toLowerCase().includes(q) ||
      a.kicker.toLowerCase().includes(q) ||
      a.description.toLowerCase().includes(q) ||
      (a.category || '').toLowerCase().includes(q);
    var matchesCategory = !filters.category || a.category === filters.category;
    var matchesDept = !filters.dept || a.dept === filters.dept;
    return matchesQuery && matchesCategory && matchesDept;
  }

  // 動態狀態列：把目前生效的篩選維度畫成可單獨解除的 [標籤 ✕] chip
  var DIM_NAMES = { category: '分類', dept: '科系' };
  function renderActiveFilters() {
    if (!filterChips) return;
    var html = '';
    ['category', 'dept'].forEach(function(dim) {
      if (filters[dim]) {
        html += '<button type="button" class="filter-chip" data-clear-dim="' + dim + '">' +
          escapeHtml(filters[dim]) + ' <span aria-hidden="true">✕</span></button>';
      }
    });
    filterChips.innerHTML = html;
    if (filterLabel) filterLabel.style.display = html ? '' : 'none';
    filterChips.querySelectorAll('[data-clear-dim]').forEach(function(chip) {
      chip.addEventListener('click', function() {
        var dim = chip.dataset.clearDim;
        filters[dim] = '';
        if (dim === 'category') syncPills('category');
        if (dim === 'dept' && deptSelect) deptSelect.value = '';
        runSearch();
      });
    });
  }

  function renderResults(results) {
    var total = results.length;
    var q = currentQuery;
    renderActiveFilters();

    if (total === 0) {
      resultsGrid.innerHTML = '';
      noResults.hidden = false;
      noResultsMsg.textContent = q
        ? '找不到關於「' + q + '」的文章，試試其他關鍵字或調整篩選。'
        : '目前的篩選條件下沒有文章，試試放寬條件。';
      resultsCount.textContent = '';
      return;
    }

    noResults.hidden = true;
    resultsCount.textContent = (q ? '「' + q + '」 ' : '') + '共 ' + total + ' 篇文章';

    resultsGrid.innerHTML = results.map(function(a) {
      var titleHtml = highlight(a.title, q);
      var descHtml = highlight(a.description, q);
      return '<article class="card article-card">' +
        '<span class="badge">' + escapeHtml(a.kicker) + '</span>' +
        '<h3><a class="text-link" href="' + escapeHtml(a.href) + '">' + titleHtml + '</a></h3>' +
        '<p class="card-desc">' + descHtml + '</p>' +
        '</article>';
    }).join('');
  }

  function updateURL() {
    var url = new URL(window.location.href);
    function setParam(key, val) {
      if (val) url.searchParams.set(key, val);
      else url.searchParams.delete(key);
    }
    setParam('q', currentQuery);
    setParam('category', filters.category);
    setParam('dept', filters.dept);
    window.history.replaceState({}, '', url.toString());
  }

  // 就地切換：搜尋/篩選結果 vs 分類瀏覽。
  // 搜尋列已前置到 hero 下，篩選啟動時同步隱藏中間的導購區（intro），讓結果緊貼搜尋列。
  var introBlock = document.querySelector('.resources-intro');
  function runSearch() {
    if (isDefault()) {
      searchResults.hidden = true;
      browseGrid.hidden = false;
      if (introBlock) introBlock.hidden = false;
      resourcesMain.classList.remove('searching');
      resultsGrid.innerHTML = '';
      noResults.hidden = true;
      resultsCount.textContent = '';
      updateURL();
      return;
    }
    browseGrid.hidden = true;
    searchResults.hidden = false;
    if (introBlock) introBlock.hidden = true;
    resourcesMain.classList.add('searching');
    renderResults(data.filter(matchesFilters));
    updateURL();
    if (currentQuery && typeof window.gtag === 'function') {
      window.gtag('event', 'search_resources', { search_term: currentQuery });
    }
  }

  // 關鍵字輸入（debounce）
  var timer;
  searchInput.addEventListener('input', function() {
    clearTimeout(timer);
    timer = setTimeout(function() {
      currentQuery = searchInput.value.trim();
      runSearch();
    }, 200);
  });

  searchForm.addEventListener('submit', function(e) {
    e.preventDefault();
    currentQuery = searchInput.value.trim();
    runSearch();
  });

  // 分類瀏覽：每類預設 6 張，展開全部
  document.querySelectorAll('.browse-more').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var sec = document.getElementById(btn.dataset.section);
      if (!sec) return;
      sec.querySelectorAll('[data-overflow]').forEach(function(el) { el.hidden = false; });
      btn.remove();
    });
  });

  // 篩選 pill：每個維度各自單選
  document.querySelectorAll('.filter-pill-row').forEach(function(row) {
    var dim = row.dataset.dim;
    row.querySelectorAll('.filter-pill').forEach(function(btn) {
      btn.addEventListener('click', function() {
        row.querySelectorAll('.filter-pill').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        filters[dim] = btn.dataset.value || '';
        runSearch();
      });
    });
  });

  function syncPills(dim) {
    var row = document.querySelector('.filter-pill-row[data-dim="' + dim + '"]');
    if (!row) return;
    row.querySelectorAll('.filter-pill').forEach(function(btn) {
      btn.classList.toggle('active', (btn.dataset.value || '') === filters[dim]);
    });
  }

  // 科系群：降級為下拉選單（取代原本整排 Chips）
  if (deptSelect) deptSelect.addEventListener('change', function() {
    filters.dept = deptSelect.value || '';
    runSearch();
  });

  // 清除：清掉關鍵字與所有篩選，回到分類瀏覽
  if (backBtn) backBtn.addEventListener('click', function() {
    currentQuery = '';
    filters = { category: '', dept: '' };
    searchInput.value = '';
    syncPills('category');
    if (deptSelect) deptSelect.value = '';
    runSearch();
    if (searchSection) searchSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // 從 URL params 初始化（讓 ?q=、?category= 等可分享、可被舊 search 連結帶入）
  var params = new URLSearchParams(window.location.search);
  currentQuery = params.get('q') || '';
  filters.category = params.get('category') || '';
  filters.dept = params.get('dept') || '';

  if (currentQuery) searchInput.value = currentQuery;
  syncPills('category');
  if (deptSelect) deptSelect.value = filters.dept;

  runSearch();
})();
</script>

</BaseLayout>
