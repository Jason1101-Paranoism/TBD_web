---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceCategories } from '../../config/resourceCategories';

const articles = await getCollection('articles');

// 依設定檔分區，從 collection 自動分組並排序產生卡片
const sections = resourceCategories.map((cat) => {
  const articleCards = articles
    .filter((a) => a.data.category === cat.category)
    .map((a) => ({
      kicker: a.data.kicker,
      title: a.data.title,
      href: `/pages/resources/${a.slug}.html`,
      desc: a.data.description,
      order: a.data.order ?? 999,
    }));
  const cards = [...articleCards, ...(cat.extraCards ?? [])].sort(
    (x, y) => x.order - y.order
  );
  return { ...cat, cards };
});

// 對照檢查：有 category 但對不到任何分區的文章（協助維護，不影響輸出）
const knownCategories = new Set(resourceCategories.map((c) => c.category));
const orphans = articles.filter((a) => !knownCategories.has(a.data.category));
if (orphans.length > 0) {
  console.warn(
    `[resources] 以下文章的 category 對不到任何分區，不會顯示在首頁：` +
      orphans.map((a) => `${a.slug} (${a.data.category})`).join(', ')
  );
}
---

<BaseLayout title="升學知識庫｜TBD Studio" description="TBD Studio 升學知識文章：申請策略、備審製作、材料累積、面試準備、各科系指南與研究所推甄，幫助你做出更清楚的準備決策。" bodyClass="sub-page resources-page">
<section class="hero">
  <span class="kicker">TBD Studio 知識庫</span>
  <h1>升學路上，你需要知道的事。</h1>
  <p class="lead">從管道選擇、備審整理、材料累積到面試準備，彙整各科系申請指南與研究所推甄策略，幫助你把力氣用在對的地方。</p>
  <form class="resources-search-bar" action="/pages/search.html" method="get">
    <div class="resources-search-wrap">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--tbd-mid); flex-shrink: 0;">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="search" name="q" placeholder="搜尋文章關鍵字…" class="resources-search-input" autocomplete="off">
      <button type="submit" class="resources-search-btn">搜尋</button>
    </div>
  </form>
</section>

<div class="resources-main">

  <!-- 側邊欄 -->
  <aside class="resources-sidebar">
    <div class="resources-sidebar-inner">
      <div class="sidebar-group">
        <p class="sidebar-nav-label">文章分類</p>
        <nav>
          {sections.map((s, i) => (
            <a href={`#${s.id}`} class={`sidebar-nav-link${i === 0 ? ' active' : ''}`}>{s.navLabel}</a>
          ))}
        </nav>
      </div>

      <div class="sidebar-group">
        <p class="sidebar-nav-label">主題指南</p>
        <nav>
          <a href="/pages/guides/admission-overview.html" class="sidebar-nav-link">申請策略全局觀 →</a>
          <a href="/pages/guides/pre-college.html" class="sidebar-nav-link">升大學前準備 →</a>
          <a href="/pages/guides/portfolio-prep.html" class="sidebar-nav-link">備審與學習歷程 →</a>
          <a href="/pages/guides/interview.html" class="sidebar-nav-link">升學面試準備 →</a>
          <a href="/pages/guides/research.html" class="sidebar-nav-link">研究所推甄 →</a>
          <a href="/pages/guides/side-project.html" class="sidebar-nav-link">Side Project 指南 →</a>
          <a href="/pages/guides/github.html" class="sidebar-nav-link">GitHub & Portfolio →</a>
          <a href="/pages/guides/competitions.html" class="sidebar-nav-link">競賽完整指南 →</a>
          <a href="/pages/guides/departments.html" class="sidebar-nav-link">各科系申請指南 →</a>
          <a href="/pages/guides/parents-guide.html" class="sidebar-nav-link">給家長完整指南 →</a>
          <a href="/pages/guides/ai-era.html" class="sidebar-nav-link">AI 時代能力建立 →</a>
          <a href="/pages/resources/tools.html" class="sidebar-nav-link">工具與模板下載 →</a>
          <a href="/pages/resources/interview-bank.html" class="sidebar-nav-link">大學面試題庫 →</a>
        </nav>
      </div>
    </div>
  </aside>

  <!-- 主內容（由 articles collection 自動生成） -->
  <div class="resources-content">

    {sections.map((s) => (
      <section class="section" id={s.id}>
        <h2 class="section-label">{s.sectionLabel}</h2>
        <p style="margin-bottom: 16px; color: var(--tbd-mid);">{s.desc}</p>
        <div class="card-grid">
          {s.cards.map((card) => (
            <article class="card article-card">
              <span class="badge">{card.kicker}</span>
              <h3><a class="text-link" href={card.href}>{card.title}</a></h3>
              <p class="card-desc">{card.desc}</p>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="section cta">
      <h2>準備開始，但不確定下一步？</h2>
      <p>TBD 的第一次策略諮詢從學生的升學管道、目前的材料狀況出發，評估最需要補強的環節，給你一份具體的準備建議——不管後續有沒有繼續合作都帶得走。</p>
      <div class="button-row">
        <a class="button secondary" href="/pages/services.html">了解服務內容</a>
        <a class="button" href="https://lin.ee/9ciZvbA?utm_source=website&utm_medium=cta&utm_campaign=resources" target="_blank" rel="noopener noreferrer" data-ga-event="click_line_resources">預約策略諮詢</a>
      </div>
    </section>

  </div>
</div>

<script>
  const links = document.querySelectorAll('.sidebar-nav-link');
  const sections = document.querySelectorAll('.resources-content .section[id]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const link = document.querySelector(`.sidebar-nav-link[href="#${entry.target.id}"]`);
        if (link) link.classList.add('active');
      }
    });
  }, { rootMargin: '-10% 0px -80% 0px' });

  sections.forEach(s => observer.observe(s));
</script>
</BaseLayout>
