---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pricingPlans, COMPASS_URL } from '../../config/pricing';

// Growth Compass 落點分析的方案說明頁（MONETIZATION_PLAN.md §5.4）。
//
// noindex 是刻意的：付費牆本身還沒上線（compass 的 purchases 尚未套用到落點頁），
// 而 §2 的 D-M2／D-M3 兩項決策團隊也還沒拍板。在那之前這一頁是給團隊內部對稿用的，
// 不該被搜尋引擎收錄，也刻意沒有掛進 Nav——上線時把 noindex 拿掉並加進 site.ts 的 nav。

const title = '落點分析方案｜TBD Studio';
const description =
  'TBD Growth Compass 落點分析：免費可以查校系、輸入級分、看基本落點；付費解鎖完整落點報告與個人化校系比對。單次解鎖 NT$499、一屆方案 NT$899。';

const freeThings = [
  {
    title: '落點分析的基本結果',
    desc: '輸入六科級分、選出想比的校系，看到基本的比對結果。這一段不會變成付費功能。',
    href: `${COMPASS_URL}/placement`,
    linkText: '直接去用',
  },
  {
    title: '29 份升學準備模板',
    desc: '備審主線整理表、研究計畫框架、套磁信公版、口試檢核表——五個學群各有專屬版本。CSV 與 Markdown 兩種格式。',
    href: '/pages/resources/tools.html',
    linkText: '看模板列表',
  },
  {
    title: '知識庫文章',
    desc: '從選管道、寫反思、整理主線到面試準備，每個階段都有對應的完整說明。',
    href: '/pages/resources.html',
    linkText: '進知識庫',
  },
];
---

<BaseLayout title={title} description={description} bodyClass="sub-page" noindex={true}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <span>落點分析方案</span>
  </nav>
  <span class="kicker">Growth Compass</span>
  <h1>把級分換算成一份看得懂的落點報告</h1>
  <p class="lead">落點不是一個數字，是「以你現在的成績，這些校系分別站在什麼位置」。Growth Compass 用歷年的級分與篩選標準做跨年度換算，把這件事算給你看。基本功能免費，完整報告需要付費解鎖。</p>
</section>

<main class="search-main">

  <section class="section" id="free">
    <h2 class="section-label">先說不用付錢的部分</h2>
    <p class="pricing-intro">把免費的講清楚，你才知道值不值得付那一筆。以下三件事一直都是免費的，不會因為推出付費方案而收起來。</p>
    <div class="card-grid">
      {freeThings.map((f) => (
        <article class="card article-card">
          <h3>{f.title}</h3>
          <p class="card-desc">{f.desc}</p>
          <p style="margin-top: 12px;"><a class="text-link" href={f.href}>{f.linkText} →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="difference">
    <h2 class="section-label">那付費解鎖的是什麼</h2>
    <p class="pricing-diff"><strong>免費版告訴你「這個校系你大概在什麼位置」；付費版告訴你「你手上這組級分，在你選的所有校系裡分別排在哪、哪幾個是真正該花時間的」。</strong></p>
    <p class="pricing-intro">差別在完整度，不在功能多寡。免費版一次看一個校系的概略位置，適合初步探路；完整報告一次把你圈選的校系全部算完並排序，是實際要填志願時需要的東西。付費解鎖的內容都在你自己的帳號裡，換裝置也還在。</p>
  </section>

  <section class="section" id="plans">
    <h2 class="section-label">兩種方案</h2>
    <div class="card-grid pricing-grid">
      {pricingPlans.map((p) => (
        <article class="card article-card pricing-card">
          <h3>{p.label}</h3>
          <p class="pricing-price"><span class="pricing-currency">NT$</span>{p.priceTwd}</p>
          <ul class="pricing-includes">
            {p.includes.map((i) => <li>{i}</li>)}
          </ul>
          <p class="card-desc pricing-suited">{p.suitedFor}</p>
        </article>
      ))}
    </div>
    <p class="pricing-note">兩個方案解鎖的落點報告是同一份，差別只在跨年度保存。如果你只是這一屆要用，單次解鎖就夠了——不需要為了「比較划算」去買用不到的效期。</p>
  </section>

  <section class="section" id="start">
    <h2 class="section-label">要怎麼開始</h2>
    <p class="pricing-intro">先用免費的版本把級分輸進去、把想比的校系圈起來。看完基本結果如果覺得需要完整報告，再從帳號裡解鎖——不必先決定。</p>
    <div class="button-row">
      <a class="button" href={`${COMPASS_URL}/placement`}>先用免費版試算</a>
      <a class="button secondary" href="/pages/services.html">我想直接找顧問談</a>
    </div>
  </section>

</main>
</BaseLayout>
