---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';

interface TocItem {
  href: string;
  label: string;
}

interface RelatedArticle {
  badge: string;
  title: string;
  href: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  lead: string;
  bodyClass?: string;
  sidebarCtaText: string;
  sidebarCtaUtm: string;
  bottomCtaH2: string;
  bottomCtaP?: string;
  bottomCtaUtm: string;
  tocItems: TocItem[];
  relatedArticles: RelatedArticle[];
  slug: string;
}

const {
  title, description, kicker, lead,
  bodyClass = 'sub-page article-page',
  sidebarCtaText, sidebarCtaUtm,
  bottomCtaH2, bottomCtaUtm,
  tocItems, relatedArticles, slug,
} = Astro.props;

const bottomCtaP = Astro.props.bottomCtaP ?? 'TBD 的第一次策略諮詢會先依據學生的升學管道、競爭力與目前最該補強的環節進行評估與建議，線上與您一起討論可能合作方案，決定是否需要文件重構、面試訓練或全程陪跑。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=${sidebarCtaUtm}`;
const bottomCtaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=${bottomCtaUtm}`;
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} ogType="article">
  <section class="hero article-hero">
    <nav class="breadcrumb">
      <a href="/index.html">首頁</a>
      <span>›</span>
      <a href="/pages/resources.html">知識庫</a>
      <span>›</span>
      <span>{title}</span>
    </nav>
    <span class="kicker">{kicker}</span>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </section>

  <main>
    <div class="article-layout">

      <article class="article-body">
        <slot />
      </article>

      <aside class="article-sidebar">
        <div class="pg-sidebar">
          <div class="pg-sidebar-head">
            <span class="pg-sidebar-kicker">本文目錄</span>
          </div>
          <nav class="pg-sidebar-nav">
            {tocItems.map(item => (
              <a href={item.href} class="pg-sidebar-link">{item.label}</a>
            ))}
          </nav>
        </div>

        <div class="sidebar-cta card">
          <p>{sidebarCtaText}</p>
          <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_article_sidebar">預約策略諮詢</a>
        </div>
      </aside>

    </div>

    <section class="section cta">
      <h2>{bottomCtaH2}</h2>
      <p>{bottomCtaP}</p>
      <div class="button-row">
        <a class="button secondary" href="/pages/resources.html">回知識庫</a>
        <a class="button" href={bottomCtaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_article_bottom">預約策略諮詢</a>
      </div>
    </section>

    <section class="section">
      <h2>延伸閱讀</h2>
      <div class="card-grid">
        {relatedArticles.map(a => (
          <article class="card article-card">
            <span class="badge">{a.badge}</span>
            <h3><a class="text-link" href={a.href}>{a.title}</a></h3>
            <p class="card-desc">{a.desc}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <script>
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.pg-sidebar-link'));
    const sections = tocLinks
      .map(a => document.querySelector(a.getAttribute('href') ?? ''))
      .filter((el): el is Element => el !== null);

    const observer = new IntersectionObserver(entries => {
      const visible = entries.find(e => e.isIntersecting);
      if (!visible) return;
      tocLinks.forEach(a => a.classList.remove('active'));
      const link = document.querySelector<HTMLAnchorElement>(`.pg-sidebar-link[href="#${visible.target.id}"]`);
      link?.classList.add('active');
    }, { rootMargin: '-10% 0px -60% 0px', threshold: 0 });

    sections.forEach(s => observer.observe(s));
  </script>
</BaseLayout>
