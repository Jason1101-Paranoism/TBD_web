---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getCollection } from 'astro:content';
import { templatesFor } from '../../../config/gradTemplates';

// 理工類群研究所申請路徑：通用階段「重用」既有研究所推甄文章，
// 只有理工真正不同的環節（提早時程、實驗室資源、技術匹配計畫書、個人貢獻備審、技術答辯）用理工專屬文。
const STAGE_ORDER = [
  { slug: 'graduate-recommend-vs-exam',      tag: '通用',   role: '先理解推甄與考試的差異；理工的路線判斷基準見下方快篩。' },
  { slug: 'engineering-graduate-timeline',   tag: '理工專屬', role: '理工的時間軸要提早到大二暑假——實驗成果不可控，備案要先排。' },
  { slug: 'engineering-graduate-choose',     tag: '理工專屬', role: '選所其實是選實驗室：查資源、判斷指導風格、看畢業去向。' },
  { slug: 'graduate-contact-professor',      tag: '通用',   role: '送件前聯繫教授；理工要多做的三件事，直達文內〈理工專屬重點〉。', anchor: '#stem-tips' },
  { slug: 'engineering-graduate-proposal',   tag: '理工專屬', role: '用技術匹配度說服教授：從已掌握的工具延伸，和實驗室接軌。' },
  { slug: 'engineering-graduate-cv',         tag: '理工專屬', role: '把團隊專題寫成個人貢獻，讓瓶頸與除錯過程成為亮點。' },
  { slug: 'engineering-graduate-oral',       tag: '理工專屬', role: '面對技術追問的答辯：解釋數據、承認邊界、展示下一步。' },
];

const bySlug = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.slug, a])
);
const stages = STAGE_ORDER
  .map((s, i) => {
    const a = bySlug[s.slug];
    if (!a) return null;
    // anchor：通用文內的理工專屬區塊（如 #stem-tips），總覽直接深連結到該段
    return { n: i + 1, tag: s.tag, role: s.role, title: a.data.title, href: `/pages/resources/${a.slug}.html${'anchor' in s && s.anchor ? s.anchor : ''}` };
  })
  .filter(Boolean);

// 可下載模板（實體檔在 public/assets/templates/，各對應一篇專屬文）
// 可下載模板：資料在 src/config/gradTemplates.ts（與 resources/tools.html 同一份來源）
const templates = templatesFor('理工');

const title = '理工研究所申請完整指南';
const description = '理工研究所推甄怎麼準備？這個指南依申請順序拆成七個階段——從推甄與考試的路線判斷、提早到大二暑假的時程，到理工專屬的選實驗室、研究計畫書（技術匹配度）、備審個人貢獻與口試技術答辯，並附五份可下載模板。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-graduate-engineering`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/graduate-engineering.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "ItemList",
      "name": "理工研究所申請的七個階段",
      "itemListElement": stages.map((s) => ({
        "@type": "ListItem",
        "position": s.n,
        "name": s.title,
        "item": `${site.siteUrl}${s.href}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/graduate-engineering.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南 · 理工類群</span>
  <h1>{title}</h1>
  <p class="lead">理工推甄和其他領域最大的不同，是核心素材——實驗數據、專題成果——需要時間累積、還常常不受控，所以時間軸要比通用時程更早。這個指南把申請拆成七個階段，和通用的研究所推甄指南同一套骨架：推甄與考試、聯繫教授沿用通用文章，理工真正不同的環節（時程、選實驗室、研究計畫、備審、口試）則有理工專屬深文，並附五份可直接下載的模板。建議照順序讀一遍，再回頭把卡住的階段讀深。</p>
</section>

<main>

  <section class="section" id="route-check">
    <h2>先做路線快篩：推甄、考試還是並行？</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">投入七個階段之前，先確認方向。以顧問經驗，理工學生可以用系排當第一層參考（是參考基準，不是絕對門檻）：</p>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">系排前段（約前 15%）</span>
        <h3>推甄為主、考試為輔</h3>
        <p class="card-desc">力氣放在專題成果整理、備審、聯繫教授與口試準備，筆試當保險。</p>
      </article>
      <article class="card article-card">
        <span class="badge">系排中段（約 15%～30%）</span>
        <h3>兩邊並重、動態平衡</h3>
        <p class="card-desc">推甄有不確定性，但不該過早放棄——維持筆試進度，同時把專題與備審做出說服力。</p>
      </article>
      <article class="card article-card">
        <span class="badge">系排後段（約 30% 之後）</span>
        <h3>以考試為主，除非有明顯亮點</h3>
        <p class="card-desc">大專生研究計畫、競賽成果、論文或專利、GitHub 專案、長期實驗室參與——有這些亮點才值得認真投入推甄，避免兩頭空。</p>
      </article>
    </div>
    <p style="margin-top: 16px; color: var(--tbd-mid);">系排之外的第二層檢核（專題能不能三分鐘說清楚、技術能力有沒有證據），見<a class="text-link" href="/pages/resources/engineering-graduate-timeline.html">理工推甄時程</a>的路線判斷一節。</p>
  </section>

  <section class="section" id="stages">
    <h2>理工研究所申請的七個階段</h2>
    <div class="guide-rail-legend">
      <span><i class="own"></i>理工專屬深文</span>
      <span><i class="reuse"></i>沿用通用文章</span>
    </div>
    <div class="guide-rail">
      {stages.map((s) => (
        <a class={`rail-stage${s.tag !== '通用' ? ' own' : ''}`} href={s.href}>
          <span class="rs-num">{s.n}</span>
          <span class="rs-node"><i></i></span>
          <span class="rs-body">
            <span class="rs-tag">{s.tag}</span>
            <span class="rs-title">{s.title}</span>
            <span class="rs-role">{s.role}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="templates">
    <h2>理工推甄專屬工具包</h2>
    <p style="margin-bottom: 16px; color: var(--tbd-mid);">五份對應各階段的工具，兩種格式任選：<strong>CSV</strong> 用 Excel / Google 試算表開；<strong>Markdown</strong> 可一鍵匯入 Notion。</p>
    <div class="card-grid">
      {templates.map((t) => (
        <article class="card article-card">
          <span class="badge">模板</span>
          <h3>{t.title}</h3>
          <p class="card-desc">{t.desc}</p>
          <div class="button-row" style="margin-top: 16px;">
            <a class="button" href={t.md} download data-track-event="download_resource">Notion / Markdown</a>
            <a class="button secondary" href={t.csv} download data-track-event="download_resource">CSV 試算表</a>
          </div>
          <p style="margin-top: 10px;"><a class="text-link" href={t.article}>看使用說明 →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="more">
    <h2>延伸與案例</h2>
    <div class="card-grid">
      <article class="card article-card">
        <span class="badge">成功案例</span>
        <h3><a class="text-link" href="/pages/cases.html">TBD Studio 升學輔導案例（含機械、工程背景）</a></h3>
        <p class="card-desc">去識別化的真實案例——機械工程特殊選才、機器人競賽到個人申請——看素材盤點與敘事重構怎麼落實成錄取結果。</p>
      </article>
      <article class="card article-card">
        <span class="badge">通用指南</span>
        <h3><a class="text-link" href="/pages/guides/graduate-application.html">研究所推甄完整指南</a></h3>
        <p class="card-desc">不分科系的研究所推甄通用流程，想先掌握整體再回到理工專屬準備，從這裡開始。</p>
      </article>
    </div>
  </section>

  <section class="section cta">
    <h2>理工推甄的時程、實驗室名單與研究計畫，想找人一起盤點？</h2>
    <p>TBD 的策略諮詢會依你的系排現況、專題累積與目標實驗室，幫你判斷推甄與考試的路線配比、檢視研究計畫書的技術匹配度，找出目前最該補強的階段。</p>
    <p class="cta-trust"><span>✓ 線上進行</span><span>✓ 不代寫</span><span>✓ 過程文件可追蹤</span></p>
    <div class="button-row">
      <a class="button secondary" href="/pages/services/graduate.html">看研究所推甄服務</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_graduate_engineering">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
