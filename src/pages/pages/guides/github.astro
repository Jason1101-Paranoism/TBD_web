---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';

const title = 'GitHub 作品集與 Portfolio 建置指南';
const description = 'GitHub 與 Portfolio 是申請資工、設計、跨域科系最直接的能力展示。這個頁面收錄 TBD Studio 從 Commit 規範、README 到作品集架構與個人網站建置的系列文章，幫你做出讓評審看懂的作品集。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-github`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/github.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/github.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南</span>
  <h1>{title}</h1>
  <p class="lead">GitHub 和個人 Portfolio 是申請資工、設計、跨域科系時最直接的能力展示工具。這個頁面收錄從 Commit 規範到 Portfolio 網站架構的完整文章指南，幫你建立一份讓評審看懂的作品集。</p>
</section>

<main>

  <section class="section" id="github">
    <h2>GitHub 作品集：怎麼讓評審看懂你做了什麼</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">GitHub</span>
        <h3><a class="text-link" href="/pages/resources/github-portfolio.html">一份強的 GitHub 作品集，長什麼樣子？</a></h3>
        <p class="card-desc">GitHub 不只是放程式碼。了解評審如何判斷一份 GitHub、常見的失誤，以及不同方向的呈現重點。</p>
      </article>

      <article class="card article-card">
        <span class="badge">GitHub</span>
        <h3><a class="text-link" href="/pages/resources/readme-guide.html">如何寫出一份讓人看懂的 README？</a></h3>
        <p class="card-desc">README 幾乎是評審對專案的唯一第一印象。好的 README 必備結構、最常見問題與 commit 紀錄原則。</p>
      </article>

      <article class="card article-card">
        <span class="badge">GitHub</span>
        <h3><a class="text-link" href="/pages/resources/github-commit-guide.html">GitHub Commit 與版本管理入門：從混亂到有結構</a></h3>
        <p class="card-desc">怎麼寫有意義的 commit、基本的 Git 工作流程，以及為什麼 commit history 是能力的間接證明。</p>
      </article>

    </div>
  </section>

  <section class="section" id="portfolio">
    <h2>個人網站與 Portfolio：把作品集整合起來</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">Portfolio</span>
        <h3><a class="text-link" href="/pages/resources/portfolio-website.html">個人網站與 Portfolio 怎麼做？</a></h3>
        <p class="card-desc">高中生適合哪些工具、Portfolio 的基本架構，以及讓作品集真正有說服力的關鍵。</p>
      </article>

      <article class="card article-card">
        <span class="badge">Portfolio 指南</span>
        <h3><a class="text-link" href="/pages/portfolio-guide.html">高中生 Portfolio 建置完整指南</a></h3>
        <p class="card-desc">從 0 開始，把三年經歷整理成教授看得懂的個人主線。含選材邏輯、結構設計與 AI prompt 工具。</p>
      </article>

      <article class="card article-card">
        <span class="badge">簡報技巧</span>
        <h3><a class="text-link" href="/pages/resources/presentation-demo.html">高中生簡報與 Demo 技巧：讓作品在三分鐘內說清楚</a></h3>
        <p class="card-desc">不管是口頭報告還是書面展示，讓作品說話的關鍵是結構，而不是視覺的複雜度。</p>
      </article>

    </div>
  </section>

  <section class="section cta">
    <h2>有 GitHub，但不知道怎麼讓它對申請有幫助？</h2>
    <p>TBD 的策略諮詢可以幫你評估目前的 GitHub 和 Portfolio 對申請的說服力，以及哪些調整最值得做。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_github">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
