---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';

const title = '備審資料與學習歷程完整指南';
const description = '從高中三年規劃到備審整理策略，涵蓋教授評審視角、主線建構、反思寫法、活動素材整理——TBD Studio 備審系列文章完整收錄。';
const ctaLink = `${site.lineUrl}?utm_source=website&utm_medium=cta&utm_campaign=guide-portfolio-prep`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": `${site.siteUrl}/pages/guides/portfolio-prep.html`,
      "inLanguage": "zh-TW"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": `${site.siteUrl}/index.html` },
        { "@type": "ListItem", "position": 2, "name": "知識庫", "item": `${site.siteUrl}/pages/resources.html` },
        { "@type": "ListItem", "position": 3, "name": title, "item": `${site.siteUrl}/pages/guides/portfolio-prep.html` }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} bodyClass="sub-page guide-page" schema={schema}>
<section class="hero">
  <nav class="breadcrumb">
    <a href="/index.html">首頁</a>
    <span>›</span>
    <a href="/pages/resources.html">知識庫</a>
    <span>›</span>
    <span>{title}</span>
  </nav>
  <span class="kicker">主題指南</span>
  <h1>{title}</h1>
  <p class="lead">備審不是活動清單，而是一個關於你的故事。這個頁面收錄 TBD Studio 所有備審與學習歷程相關文章，幫助你建立主線、理解評審邏輯、整理出真正有說服力的申請材料。</p>
</section>

<main>

  <section class="section" id="mindset">
    <h2>先建立正確的備審觀念</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">升學觀念</span>
        <h3><a class="text-link" href="/pages/resources/high-score-not-enough.html">為什麼高分不一定能申請上頂大？</a></h3>
        <p class="card-desc">分數是入場券，不是錄取標準。說明頂大真正在篩什麼，以及成績以外你需要準備的事。</p>
      </article>

      <article class="card article-card">
        <span class="badge">備審策略</span>
        <h3><a class="text-link" href="/pages/resources/reviewer-perspective.html">教授 30 秒看備審，真正在評估什麼？</a></h3>
        <p class="card-desc">評審的閱讀方式、他們在問的三個核心問題，以及讓備審真正有效的關鍵特徵。</p>
      </article>

      <article class="card article-card">
        <span class="badge">備審策略</span>
        <h3><a class="text-link" href="/pages/resources/strong-applicant-traits.html">強申請者有哪些共同特徵？</a></h3>
        <p class="card-desc">觀察每年脫穎而出的申請者，他們在備審和面試上有哪些共同點。</p>
      </article>

    </div>
  </section>

  <section class="section" id="planning">
    <h2>高中三年怎麼規劃？</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">學習歷程</span>
        <h3><a class="text-link" href="/pages/resources/three-year-plan.html">高中三年怎麼規劃？從探索到整理的完整框架</a></h3>
        <p class="card-desc">高一探索、高二累積、高三整理，三個年級的目標其實不一樣。</p>
      </article>

      <article class="card article-card">
        <span class="badge">學習歷程</span>
        <h3><a class="text-link" href="/pages/resources/learning-main-thread.html">學習歷程主線是什麼？為什麼比活動數量更重要</a></h3>
        <p class="card-desc">主線不是最多的活動，而是最有邏輯的故事。說明「申請主線」的概念與找法。</p>
      </article>

      <article class="card article-card">
        <span class="badge">學習歷程</span>
        <h3><a class="text-link" href="/pages/resources/no-resources.html">沒有特殊資源，也能做出強的學習歷程嗎？</a></h3>
        <p class="card-desc">評審真正在看的不是資源多寡，而是在有限條件下你做了什麼選擇。</p>
      </article>

    </div>
  </section>

  <section class="section" id="organizing">
    <h2>整理備審：從散亂素材到清晰主線</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">備審策略</span>
        <h3><a class="text-link" href="/pages/resources/why-busy-not-strong.html">為什麼活動很多，備審卻還是看起來很散？</a></h3>
        <p class="card-desc">活動清單和申請故事的根本差別，以及如何快速診斷自己的備審問題。</p>
      </article>

      <article class="card article-card">
        <span class="badge">備審策略</span>
        <h3><a class="text-link" href="/pages/resources/scatter-to-story.html">如何把零散的活動整理成一條有邏輯的故事？</a></h3>
        <p class="card-desc">活動看起來很散，不是材料問題而是視角問題。四個步驟找到你的真實主線。</p>
      </article>

      <article class="card article-card">
        <span class="badge">備審策略</span>
        <h3><a class="text-link" href="/pages/resources/reflection-in-portfolio.html">學習歷程中的「反思」到底是什麼？</a></h3>
        <p class="card-desc">反思不是感想段落——三種有效反思結構、兩個最常見陷阱，以及如何讓反思變成習慣。</p>
      </article>

      <article class="card article-card">
        <span class="badge">給家長</span>
        <h3><a class="text-link" href="/pages/resources/parent-misconceptions.html">家長最常誤解的備審準備方式</a></h3>
        <p class="card-desc">四個常見誤解，以及家長真正能幫上孩子升學準備的事。</p>
      </article>

    </div>
  </section>

  <section class="section" id="by-major">
    <h2>各科系的備審重點</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">科系指南</span>
        <h3><a class="text-link" href="/pages/resources/cs-ai-application.html">申請資工、AI 科系，備審要展示什麼？</a></h3>
        <p class="card-desc">資工和 AI 科系備審的核心評估標準，以及如何呈現程式能力和研究潛力。</p>
      </article>

      <article class="card article-card">
        <span class="badge">科系指南</span>
        <h3><a class="text-link" href="/pages/resources/design-application.html">設計科系備審要展示什麼？從作品到思維的準備指南</a></h3>
        <p class="card-desc">設計備審評估的不只是作品的美感，更是你的設計思維和決策過程。</p>
      </article>

      <article class="card article-card">
        <span class="badge">科系指南</span>
        <h3><a class="text-link" href="/pages/resources/business-application.html">商管、社科科系備審怎麼規劃主線？</a></h3>
        <p class="card-desc">商管社科備審的核心不是活動數量，而是你對某個問題的真實好奇心和分析視角。</p>
      </article>

      <article class="card article-card">
        <span class="badge">科系指南</span>
        <h3><a class="text-link" href="/pages/resources/stem-application.html">理工科系備審如何呈現研究與技術經驗？</a></h3>
        <p class="card-desc">理工備審的核心是你有沒有真正動手做過東西，以及你遇到問題時怎麼思考。</p>
      </article>

    </div>
  </section>

  <section class="section" id="special">
    <h2>特殊選才管道</h2>
    <div class="card-grid">

      <article class="card article-card">
        <span class="badge">特殊選才</span>
        <h3><a class="text-link" href="/pages/resources/special-admission-choose.html">特殊選才怎麼選？什麼情況真的適合走這條路？</a></h3>
        <p class="card-desc">特選的評選邏輯、適合的學生輪廓、常見迷思，以及決定要不要走特選的三個問題。</p>
      </article>

      <article class="card article-card">
        <span class="badge">特殊選才</span>
        <h3><a class="text-link" href="/pages/resources/special-admission-portfolio.html">特殊選才備審跟個人申請差在哪裡？如何分別準備？</a></h3>
        <p class="card-desc">兩種管道的備審邏輯根本不同。同時走兩條路的學生，最常犯的錯誤是用同一份材料應對不同的評選標準。</p>
      </article>

    </div>
  </section>

  <section class="section cta">
    <h2>備審已有初稿，但不知道問題在哪裡？</h2>
    <p>TBD 的備審健檢會從教授的閱讀視角出發，找出主線是否清晰、素材是否說話、反思是否有深度，給你一份有具體建議的結構化回饋報告。</p>
    <div class="button-row">
      <a class="button secondary" href="/pages/resources.html">回知識庫</a>
      <a class="button" href={ctaLink} target="_blank" rel="noopener noreferrer" data-ga-event="click_line_guide_portfolio_prep">預約策略諮詢</a>
    </div>
  </section>

</main>
</BaseLayout>
